# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Removes the "API KEY REQUIRED" watermark CARTO now stamps on unauthenticated basemap tile
# requests (src/components/marketing/ServiceAreaMap.astro). Free, no CARTO account needed,
# 5M tiles/month: request one at https://carto.com/basemaps/apikey and paste it below.
PUBLIC_CARTO_API_KEY=
