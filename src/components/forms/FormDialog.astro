---
import FormField from './FormField.astro';
import type { ContactFormDef } from '../../config/contact-forms';

interface Props {
  form: ContactFormDef;
}

const { form } = Astro.props;
const titleId = `${form.id}-title`;
const introId = `${form.id}-intro`;

// Everything below that a topic can override renders with the default topic's
// copy; applyTopic() in ContactDialogs.astro rewrites it whenever the topic
// changes, including on open. Rendering the default rather than a placeholder
// keeps the markup meaningful on its own.
const defaultTopic = form.topics.find((topic) => topic.value === form.defaultTopic) ?? form.topics[0];
---

{/* Real element standing in for ::backdrop — see the comment on .dialog-panel in
   marketing.css for why this dialog is opened with show() instead of showModal(). */}
<div class="dialog-backdrop" data-dialog-backdrop={form.id}></div>

<dialog id={`dialog-${form.id}`} class="dialog-panel" aria-labelledby={titleId} data-contact-dialog={form.id}>
  <div class="flex items-start justify-between gap-4 border-b border-refinery-color-border px-5 py-4">
    <div>
      <h2 id={titleId} class="font-heading text-lg font-bold text-slate-900" data-dialog-title>
        {defaultTopic.title}
      </h2>
      <p id={introId} class="mt-1 text-sm text-slate-500" data-dialog-intro>{defaultTopic.intro}</p>
    </div>
    <button
      type="button"
      data-dialog-close
      aria-label="Close"
      class="shrink-0 rounded-control p-1 text-slate-500 transition-colors duration-fast ease-out-soft hover:text-brand-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-brand-accent"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="dialog-body px-5 py-4">
    <form data-contact-form={form.id} data-subject={defaultTopic.subject} aria-describedby={introId}>
      <div class="flex flex-col gap-4">
        {form.fields.map((field) => <FormField field={field} idPrefix={form.id} />)}
      </div>

      {/* Honeypot: real visitors never see or fill this in. Not display:none —
         some bots and some form-relay spam filters both skip that. Clipped to
         1px rather than pushed off-canvas so it can't widen the dialog's
         scrollable area. */}
      <div class="absolute h-px w-px overflow-hidden whitespace-nowrap" style="clip-path: inset(50%)" aria-hidden="true">
        <label for={`${form.id}-website`}>Leave this field blank</label>
        <input type="text" id={`${form.id}-website`} name="website" tabindex="-1" autocomplete="off" />
      </div>

      {/* hCaptcha, via Web3Forms' client script — see docs/contact-form-apps-script.md's
         sibling note in forms.ts. Web3Forms' script scans the page for this div and swaps
         in the widget, which creates a hidden `<textarea name="h-captcha-response">` inside
         it once solved. That textarea lives inside this <form>, so the existing
         `new FormData(form)` submit logic in ContactDialogs.astro picks it up automatically
         — no submit-payload changes needed, only a pre-submit "did they solve it" check.
         Safe to keep inline in the scrolling body now — the challenge's earlier "under the
         popup" issue was showModal()'s top-layer stacking (fixed in marketing.css's
         .dialog-panel comment), not this container's overflow, so nothing here reintroduces
         that bug. */}
      <div class="h-captcha mt-4" data-captcha="true"></div>

      <p class="mt-4 text-sm" role="status" aria-live="polite" data-form-status></p>

      <div class="mt-2 flex items-center justify-end gap-3">
        <button type="button" data-dialog-close class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary" data-submit-button>
          {defaultTopic.submitLabel ?? form.submitLabel}
        </button>
      </div>
    </form>

    <div class="hidden flex-col items-center py-6 text-center" data-form-success>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-10 w-10 text-brand-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <path d="m9 12 2 2 4-4" />
      </svg>
      <h3 class="mt-3 font-heading text-base font-bold text-slate-900" data-success-title>
        {defaultTopic.successTitle ?? form.successTitle}
      </h3>
      <p class="mt-1 text-sm text-slate-600" data-success-body>{defaultTopic.successBody ?? form.successBody}</p>
      <button type="button" data-dialog-close class="btn btn-secondary mt-5">Close</button>
    </div>
  </div>
</dialog>
