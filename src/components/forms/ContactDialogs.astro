---
import FormDialog from './FormDialog.astro';
import { contactForm } from '../../config/contact-forms';
---

<FormDialog form={contactForm} />

{/* hCaptcha widget loader — scans the page for [data-captcha] and swaps in the challenge.
   Free-tier Web3Forms accounts use their shared site key automatically (no signup or key
   of our own needed); server-side verification only actually enforces once "hCaptcha" is
   turned on as the preferred captcha for this form in the Web3Forms dashboard. */}
<script is:inline src="https://web3forms.com/client/script.js" async defer></script>

<script>
  import { isFormConfigured, formDelivery, CONTACT_EMAIL } from '../../config/forms';
  import { contactForm } from '../../config/contact-forms';

  const topicsByValue = new Map(contactForm.topics.map((topic) => [topic.value, topic]));

  // A topic the VISITOR chose from the radio group, as opposed to one a trigger
  // imposed. Only their own choice survives a close-and-reopen from a generic
  // button — inheriting the Partner button's topic into a plain "Contact Us"
  // would open the popup titled for a conversation they never asked to have.
  let visitorChosenTopic: string | null = null;

  // Popups only ever open when there's somewhere for a submission to go.
  // With a blank config in a production build, every [data-contact-open]
  // trigger is left alone and falls through to its mailto: href — exactly
  // how the site behaved before these dialogs existed. import.meta.env.DEV
  // lets the popups still be reviewed locally before a provider is wired in.
  const canOpen = isFormConfigured || import.meta.env.DEV;

  // Opened with dialog.show(), not showModal() — see the comment on .dialog-panel in
  // marketing.css for why (a captcha challenge overlay needs to render in the same normal
  // stacking context as the dialog, which showModal()'s browser "top layer" makes
  // impossible regardless of z-index). Everything showModal() gives for free — backdrop,
  // focus trap, Esc-to-close, inert background, focus restore — is hand-rolled below.
  let lastFocusedTrigger: HTMLElement | null = null;

  function backdropFor(dialog: HTMLDialogElement): HTMLElement | null {
    const id = dialog.dataset.contactDialog;
    return document.querySelector<HTMLElement>(`[data-dialog-backdrop="${id}"]`);
  }

  // Isolates the open dialog from the rest of the page for keyboard/screen-reader users —
  // inert both removes background elements from the tab order (a full focus trap, since the
  // dialog + its backdrop are the only non-inert content left) and blocks their interaction.
  //
  // Deliberately an ALLOWLIST of the site's own known layout regions, not "every body child
  // except the dialog/backdrop". hCaptcha's expanded challenge is a normal-layer overlay
  // that's also appended directly to <body> — the exact mechanism this dialog system now
  // relies on for its own stacking fix — so a denylist here would inert the captcha's own
  // challenge along with everything else. inert implies pointer-events: none, so clicks on
  // an inert element pass through to whatever's behind it; that's what made the challenge
  // look like it was routing clicks into the form's text fields instead of itself.
  function setBackgroundInert(makeInert: boolean) {
    document.querySelectorAll<HTMLElement>('body > header, body > main, body > footer').forEach((el) => {
      if (makeInert) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    });
  }

  // A required checkbox group means "tick at least one", but HTML's `required`
  // on a checkbox means "tick THIS one". FormField.astro renders every box in the
  // group as required so an untouched group blocks submit with native validation;
  // this clears the attribute across the group the moment any box is ticked, and
  // restores it if they're all un-ticked again.
  function syncCheckboxGroups(root: ParentNode) {
    root.querySelectorAll<HTMLElement>('[data-checkbox-group]').forEach((group) => {
      const boxes = group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
      const anyChecked = Array.from(boxes).some((box) => box.checked);
      boxes.forEach((box) => {
        box.required = !anyChecked;
      });
    });
  }

  // The topic drives everything that used to differ between two separate dialogs:
  // the heading, the intro, the subject line, the button and success copy, and
  // which questions are on screen. Called on open and again whenever someone
  // changes the topic themselves, so the popup always describes what it's for.
  //
  // `lockTopic` hides the topic question — used when a trigger already declared
  // its topic, since there's nothing to ask. It's hidden but NOT disabled: the
  // answer still has to reach the payload.
  function applyTopic(dialog: HTMLDialogElement, topicValue: string, lockTopic: boolean) {
    const topic = topicsByValue.get(topicValue) ?? topicsByValue.get(contactForm.defaultTopic);
    if (!topic) return;

    const form = dialog.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;

    const radio = form.querySelector<HTMLInputElement>(
      `input[name="topic"][value="${CSS.escape(topic.value)}"]`,
    );
    if (radio) radio.checked = true;

    const setText = (selector: string, text: string) => {
      const el = dialog.querySelector<HTMLElement>(selector);
      if (el) el.textContent = text;
    };
    setText('[data-dialog-title]', topic.title);
    setText('[data-dialog-intro]', topic.intro);
    setText('[data-submit-button]', topic.submitLabel ?? contactForm.submitLabel);
    setText('[data-success-title]', topic.successTitle ?? contactForm.successTitle);
    setText('[data-success-body]', topic.successBody ?? contactForm.successBody);
    form.dataset.subject = topic.subject;

    const topicField = form.querySelector<HTMLElement>('[data-field="topic"]');
    if (topicField) topicField.hidden = lockTopic;

    form.querySelectorAll<HTMLElement>('[data-topics]').forEach((field) => {
      const onTopic = (field.dataset.topics ?? '').split('|').includes(topic.value);
      field.hidden = !onTopic;
      // Disabling is what actually scopes the question — a disabled control is
      // skipped by both checkValidity() and FormData, so an off-topic required
      // field can neither block submit nor land in the email.
      field
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea, select')
        .forEach((control) => {
          control.disabled = !onTopic;
        });
    });

    syncCheckboxGroups(form);
  }

  function openDialog(dialog: HTMLDialogElement) {
    if (dialog.open) return;
    lastFocusedTrigger = document.activeElement as HTMLElement;
    const backdrop = backdropFor(dialog);
    backdrop?.classList.add('is-open');
    document.documentElement.classList.add('dialog-open');
    setBackgroundInert(true);
    dialog.show();
    // Close button is a conventional, always-safe initial focus target — doesn't skip a
    // sighted keyboard user straight into the first field before they've read the intro.
    dialog.querySelector<HTMLElement>('[data-dialog-close]')?.focus();
  }

  /**
   * Values this mechanism seeded, keyed by field name.
   *
   * Needed because the form deliberately survives an accidental close WITHOUT resetting —
   * see the 'close' handler, which only calls form.reset() after a successful send. So a
   * later open must be able to tell "still showing what we put there" from "the visitor
   * typed this", and overwrite only the former. Clearing a draft someone was mid-way
   * through would be a far worse bug than a stale seed.
   */
  const seeded = new Map<string, string>();

  /**
   * Seeds form fields from a trigger's data-contact-prefill, e.g. a team page's CTA filling
   * in "Interested in joining team 1501" and pre-selecting the mentoring option.
   *
   * Runs AFTER applyTopic, which enables and disables the topic-scoped fields — the message
   * box exists in several topic-scoped variants sharing one name, and only the on-topic one
   * is enabled, so filtering on `disabled` is what picks the right box.
   */
  function applyPrefill(dialog: HTMLDialogElement, raw: string | undefined) {
    const form = dialog.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;

    let prefill: Record<string, string> = {};
    if (raw) {
      try {
        prefill = JSON.parse(raw);
      } catch {
        // A malformed attribute is an authoring bug, not a reason to refuse to open.
        prefill = {};
      }
    }

    // Union with everything previously seeded, so a trigger that supplies nothing CLEARS
    // an earlier seed rather than leaving another team's text stranded in the box.
    const names = new Set([...Object.keys(prefill), ...seeded.keys()]);

    names.forEach((name) => {
      const value = prefill[name] ?? '';
      const controls = Array.from(
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`),
      ).filter((control) => !control.disabled);
      if (controls.length === 0) return;

      const radios = controls.filter(
        (control): control is HTMLInputElement => (control as HTMLInputElement).type === 'radio',
      );

      if (radios.length > 0) {
        const checked = radios.find((radio) => radio.checked);
        // Untouched means still on the server-rendered default (defaultChecked, which is
        // the `default` declared in contact-forms.ts) or still on our own last seed.
        const untouched =
          !checked || checked.defaultChecked || checked.value === seeded.get(name);
        if (!untouched) return;

        const target = radios.find((radio) => radio.value === value);
        if (target) {
          target.checked = true;
          seeded.set(name, value);
        } else {
          // Nothing to seed: put the group back on its declared default rather than
          // leaving another trigger's choice selected.
          const fallback = radios.find((radio) => radio.defaultChecked);
          if (fallback) fallback.checked = true;
          seeded.delete(name);
        }
        return;
      }

      const field = controls[0];
      const untouched = field.value === field.defaultValue || field.value === seeded.get(name);
      if (!untouched) return;

      field.value = value;
      if (value) seeded.set(name, value);
      else seeded.delete(name);
    });
  }

  function closeDialog(dialog: HTMLDialogElement) {
    if (!dialog.open) return;
    dialog.close(); // fires 'close' — cleanup lives in that listener, shared with Esc/backdrop/etc.
  }

  function init() {
    const dialogs = document.querySelectorAll<HTMLDialogElement>('[data-contact-dialog]');
    if (dialogs.length === 0) return;

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-contact-open]');
      if (!trigger) return;

      const dialogId = trigger.dataset.contactOpen;
      const dialog = document.querySelector<HTMLDialogElement>(`[data-contact-dialog="${dialogId}"]`);
      if (!canOpen || !dialog) return;

      e.preventDefault();

      // No topic on the trigger means a generic entry point ("Contact Us"): leave
      // the question on screen to be asked, restoring their own earlier answer if
      // they had one and otherwise starting from the default.
      const declaredTopic = trigger.dataset.contactTopic;
      applyTopic(
        dialog,
        declaredTopic ?? visitorChosenTopic ?? contactForm.defaultTopic,
        Boolean(declaredTopic),
      );

      // What the message is about, when the trigger knows — a team page's CTA names its
      // team. Reset on every open rather than only when present, so context from one
      // trigger can't leak into a later message opened from a generic button.
      const aboutField = dialog.querySelector<HTMLInputElement>('[data-contact-about-field]');
      if (aboutField) aboutField.value = trigger.dataset.contactAbout ?? '';

      applyPrefill(dialog, trigger.dataset.contactPrefill);

      openDialog(dialog);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openDialogEl = document.querySelector<HTMLDialogElement>('dialog[open]');
      if (openDialogEl) closeDialog(openDialogEl);
    });

    dialogs.forEach((dialog) => {
      const form = dialog.querySelector<HTMLFormElement>('[data-contact-form]');
      const success = dialog.querySelector<HTMLElement>('[data-form-success]');
      const statusEl = dialog.querySelector<HTMLElement>('[data-form-status]');
      if (!form || !success || !statusEl) return;

      backdropFor(dialog)?.addEventListener('click', () => closeDialog(dialog));

      form.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        // Only reachable while the topic question is visible, which is exactly when
        // it isn't locked to a trigger's topic — hence lockTopic: false.
        if (target.name === 'topic') {
          visitorChosenTopic = target.value;
          applyTopic(dialog, target.value, false);
        } else if (target.type === 'checkbox') {
          syncCheckboxGroups(form);
        }
      });
      // 'reset' fires before the fields actually revert, so re-sync on the next task.
      form.addEventListener('reset', () => setTimeout(() => syncCheckboxGroups(form)));

      dialog.querySelectorAll<HTMLButtonElement>('[data-dialog-close]').forEach((btn) => {
        btn.addEventListener('click', () => closeDialog(dialog));
      });

      dialog.addEventListener('close', () => {
        const backdrop = backdropFor(dialog);
        backdrop?.classList.remove('is-open');
        // Only clear inert/dialog-open if no OTHER dialog is still open — defensive,
        // since this popup is currently the only one on the page, but cheap to guard.
        if (!document.querySelector('dialog[open]')) {
          document.documentElement.classList.remove('dialog-open');
          setBackgroundInert(false);
        }
        lastFocusedTrigger?.focus();

        statusEl.textContent = '';
        // Rebuild the full class list, not just 'text-sm' — this is an assignment, so it drops
        // every class the markup declared, and the mt-4 never came back after the first close.
        statusEl.className = 'mt-4 text-sm';

        // Only clear the form once a submission actually succeeded — an
        // accidental Esc or backdrop click should never erase what someone
        // was in the middle of writing.
        if (!success.classList.contains('hidden')) {
          form.reset();
          visitorChosenTopic = null; // a sent message is finished business, not a choice to restore
          form.classList.remove('hidden');
          success.classList.add('hidden');
          success.classList.remove('flex');
        }
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
        if (honeypot && honeypot.value) return; // silently drop — a real visitor never fills this in

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        // hCaptcha inserts a `<textarea name="h-captcha-response">` inside its widget div
        // once solved — querying fresh here (not caching at init) since the widget's
        // third-party script may still be initializing when the dialog first opens. This
        // is a friendly client-side nudge only; Web3Forms enforces the real check
        // server-side once hCaptcha is turned on as the form's preferred captcha.
        const captchaResponse = form.querySelector<HTMLTextAreaElement>('textarea[name="h-captcha-response"]');
        if (!captchaResponse || !captchaResponse.value) {
          statusEl.textContent = 'Please complete the captcha before submitting.';
          statusEl.classList.add('text-red-600');
          return;
        }

        const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit-button]');

        if (!isFormConfigured) {
          statusEl.textContent = `Form delivery isn't configured yet. Please email us directly at ${CONTACT_EMAIL}.`;
          statusEl.classList.add('text-red-600');
          return;
        }

        const payload: Record<string, string> = {};
        new FormData(form).forEach((value, key) => {
          if (key === 'website') return;
          // `about` is set only by triggers that know what the message concerns (a team
          // page's CTA). Every other message would otherwise carry an empty one.
          if (key === 'about' && !String(value).trim()) return;
          // Checkbox groups repeat one key per ticked box — collapse them into a
          // single readable value instead of letting the last one win.
          payload[key] = payload[key] ? `${payload[key]}, ${value}` : String(value);
        });
        payload[formDelivery.subjectKey] = form.dataset.subject ?? '';
        Object.assign(payload, formDelivery.hiddenFields);

        const originalLabel = submitBtn?.textContent ?? '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending…';
        }
        statusEl.textContent = '';
        statusEl.classList.remove('text-red-600');

        try {
          const requestInit: RequestInit =
            formDelivery.encoding === 'json'
              ? {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                  body: JSON.stringify(payload),
                }
              : {
                  method: 'POST',
                  body: Object.entries(payload).reduce((fd, [key, value]) => {
                    fd.append(key, value);
                    return fd;
                  }, new FormData()),
                };

          const res = await fetch(formDelivery.endpoint, requestInit);
          if (!res.ok) throw new Error(`Request failed (${res.status})`);

          form.classList.add('hidden');
          success.classList.remove('hidden');
          success.classList.add('flex');
          // Focus follows the content. The element focus was on is inside the form we just
          // hid, so without this focus is left on a display:none node — no announcement, and
          // no way back into the dialog by keyboard. Keep the class toggle above exactly as
          // it is: the 'close' handler reads success's `hidden` class as its "did this send
          // succeed?" flag, so it is load-bearing state, not just styling.
          success.focus();
        } catch {
          statusEl.innerHTML = `Something went wrong sending your message. <a href="mailto:${CONTACT_EMAIL}" class="underline hover:text-brand-accent">Email us directly</a>.`;
          statusEl.classList.add('text-red-600');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalLabel;
          }
        }
      });
    });
  }

  init();
  // No-op today (no client-side router is in use), but keeps this correct
  // if view transitions are ever enabled later — matches MarketingLayout's
  // reveal script.
  document.addEventListener('astro:page-load', init);
</script>
