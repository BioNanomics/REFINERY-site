---
// Replaces Starlight's default header (logo + search + theme/social icons)
// with a minimal header: just the logo (still links to the docs home) and a
// button back to the main marketing site.
// @ts-expect-error — virtual module has no ambient types outside Starlight's own package
import SiteTitle from 'virtual:starlight/components/SiteTitle';

const backHref = `${import.meta.env.BASE_URL}`;
---

<div class="refinery-header">
  <SiteTitle />
  <a href={backHref} class="refinery-back-link">
    &larr; Back<span class="refinery-back-extra"> to main site</span>
  </a>
</div>

<style>
  .refinery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    /* Leave room for Starlight's fixed mobile menu button in the same corner. */
    padding-inline-end: calc(var(--sl-menu-button-size, 0rem) + 0.5rem);
  }
  .refinery-back-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .refinery-back-link:hover {
    text-decoration: underline;
  }
  .refinery-back-extra {
    display: none;
  }
  @media (min-width: 50rem) {
    .refinery-header {
      padding-inline-end: 0;
    }
    .refinery-back-extra {
      display: inline;
    }
  }
  :global(.site-title img) {
    height: 2rem;
    width: auto;
  }
</style>
