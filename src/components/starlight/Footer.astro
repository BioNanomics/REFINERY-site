---
/**
 * Extends Starlight's default footer (prev/next pagination, edit link, last-updated) with
 * the same FIRST trademark disclaimer that marketing.css pages render in SiteFooter.astro —
 * required per FIRST's Policy on the Use of FIRST Trademarks and Copyrighted Materials
 * (rev. 04/19/25), Section IV.A. /resources content references these marks too (e.g. the
 * mentor-guides and technical docs), so it needs the same notice.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="not-content" style="font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); margin-top: 1.5rem;">
  <i class="first-mark">FIRST</i>®, <i class="first-mark">FIRST</i>® Robotics Competition, <i class="first-mark">FIRST</i>® Tech
  Challenge, FRC®, and FTC® are registered trademarks of <i class="first-mark">FIRST</i>®
  (<a href="https://www.firstinspires.org" target="_blank" rel="noopener noreferrer">www.firstinspires.org</a>),
  which is not overseeing, involved with, or responsible for this activity, product, or service.
</p>
