---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import FirstText from '../brand/FirstText.astro';
import SocialLinks from '../marketing/SocialLinks.astro';
import { withBase } from '../../utils/base';
import { PROGRAM_NAMES, teamPath } from '../../utils/teams';

interface Props {
  team: CollectionEntry<'teams'>;
  /**
   * Forces this card's own ® rather than deferring to the page's shared first-use registry.
   * Needed wherever a card might render into the DOM but stay hidden (RandomTeamsTeaser
   * renders the full team pool and reveals a random few client-side) — the registry claims
   * happen at server-render time against ALL cards, visible or not, so a hidden card can
   * silently consume the page's one-time claim and leave every visible mention unmarked.
   * The full /about/teams/ listing never hides cards, so it omits this and keeps the
   * minimal first-occurrence marking the policy prefers.
   */
  forceReg?: boolean;
}

const { team, forceReg } = Astro.props;
const { number, name, program, organization, community, logo, description, highlight, links, socials, newTeam } = team.data;

// The schema's FRC/FTC values are internal data keys. A card badge is a standalone label
// with no guaranteed earlier mention on the page, so it carries the full program name —
// which also satisfies the guidelines' requirement (p. 32) that team identification appear
// in conjunction with the program name. PROGRAM_NAMES lives in src/utils/teams.ts so this
// card and the detail page can't drift apart on the wording.
const href = teamPath(team);

// The news page's team filter is keyed on team number, so a card can offer a deep link
// into it. Only when the team is actually referenced somewhere — a chip that matches
// nothing would land the visitor on an empty grid. The draft predicate must match
// src/pages/news/index.astro, or the link can promise coverage the grid never renders.
const newsPosts = await getCollection('news', ({ data }) => !data.draft);
const hasNews = newsPosts.some((p) => p.data.teamRefs.includes(number));

// Every item in the links row carries the divider; `last:` drops it from whichever
// item ends up last in the DOM, so the rule never dangles whether the row is one
// News link, one outbound link, or all of them. `gap-3` still separates the items;
// the padding widens that gap on either side of the rule so it has room to read.
const linkDivider =
  'mr-1 border-r border-slate-200 pr-4 last:mr-0 last:border-r-0 last:pr-0';
---

{/* Whole-card click, but still a <div> rather than an <a>. Wrapping the card in an anchor
    would nest the ten-odd links it already contains inside another one, which is invalid
    and breaks assistive tech; a stretched ::after overlay would instead sit ON TOP of those
    links and kill text selection. So the navigation is delegated in the script below, which
    defers to any real link the click landed on.

    The heading link is what makes this reachable without a mouse — the card itself is
    deliberately not focusable, since a tabindex here would add a second tab stop to every
    tile leading exactly where the heading already leads. `.card-link` supplies the hover
    lift; its own comment in marketing.css scopes it to cards that ARE or CONTAIN a link. */}
<div
  class="card card-link card-pad group cursor-pointer"
  data-reveal
  data-team-card-link={href}
>
  {
    newTeam && (
      <span class="absolute -top-2.5 right-4 border border-brand-accent-fill bg-brand-accent-fill px-2 py-0.5 font-mono text-[0.65rem] font-semibold uppercase tracking-wide text-slate-900">
        New!
      </span>
    )
  }
  <div class="flex items-center gap-3">
    {/* Team logos range from square badges to wide wordmarks, so fix the height
        and let width follow the aspect ratio instead of cropping to a square. */}
    {logo && <Image src={logo} alt={`${name} logo`} class="h-12 w-auto max-w-[5rem] shrink-0 object-contain" />}
    <div>
      <p class="font-mono text-[0.7rem] font-medium uppercase tracking-wide text-slate-500">
        <FirstText text={PROGRAM_NAMES[program]} reg={forceReg} /> {number}
      </p>
      <h3 class="font-heading text-base font-bold text-slate-900">
        <a
          href={href}
          class="rounded-sm transition-colors duration-fast ease-out-soft group-hover:text-brand-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
        >
          {name}
        </a>
      </h3>
    </div>
  </div>
  <p class="mt-2 text-xs text-slate-500">{organization} &middot; {community}</p>
  <p class="mt-2 text-sm text-slate-600"><FirstText text={description} reg={forceReg} /></p>
  {highlight && <p class="mt-2 font-mono text-xs text-brand-accent">{highlight}</p>}
  {
    (hasNews || links.length > 0) && (
      <ul class="mt-4 flex flex-wrap gap-3">
        {/* Leads the row: the one destination that stays on this site, so it takes
            &rarr; where the team's own outbound links take &nearr;. */}
        {hasNews && (
          <li class={linkDivider}>
            <a
              href={withBase(`news/?team=${number}`)}
              class="font-mono text-xs font-semibold text-brand-accent hover:underline"
              aria-label={`News about ${name}`}
            >
              News &rarr;
            </a>
          </li>
        )}
        {links.map((link) => (
          <li class={linkDivider}>
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="font-mono text-xs font-semibold text-brand-accent hover:underline">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <SocialLinks socials={socials} owner={name} class="mt-3" />
</div>

<script>
  // Delegated from the document, not bound per card: /about/teams/ renders fifteen of these
  // and the About page renders every team into the DOM to reveal a random few. Astro bundles
  // this module once however many times the component appears.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const card = target.closest<HTMLElement>('[data-team-card-link]');
    if (!card) return;

    // Any real link or button inside the card wins outright — the heading link, the News
    // deep link, the team's outbound links, and the social icon row all live in here.
    if (target.closest('a, button')) return;

    // Someone dragging out a team name or address ends their mouseup on the card. Treating
    // that as a click would navigate away from the text they just selected.
    if (window.getSelection()?.toString()) return;

    const href = card.dataset.teamCardLink;
    if (!href) return;

    // Honour the modifiers a real link would: cmd/ctrl/middle-click opens a new tab rather
    // than yanking the visitor off the directory they were browsing.
    if (event.metaKey || event.ctrlKey || event.shiftKey) {
      window.open(href, '_blank', 'noopener');
      return;
    }

    window.location.assign(href);
  });
</script>
