---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/base';
import { NEWS_CATEGORY_BADGES } from '../../utils/news-categories';
import FirstText from '../brand/FirstText.astro';

interface Props {
  post: CollectionEntry<'news'>;
  loading?: 'eager' | 'lazy';
}

const { post, loading = 'lazy' } = Astro.props;
const { title, summary, pubDate, category, heroImage, heroImageAlt, sourceUrl, sourceName } = post.data;
// timeZone: 'UTC' — frontmatter dates are bare `YYYY-MM-DD`, which parse as UTC midnight.
// Without this, formatting in a behind-UTC locale renders the previous day.
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const href = sourceUrl ?? withBase(`news/${post.id}/`);
// data-no-external-arrow: the whole card is the anchor, so the automatic ::after would
// trail the entire card. The arrow lives beside the source attribution below instead.
const linkProps = sourceUrl
  ? { target: '_blank', rel: 'noopener noreferrer', 'data-no-external-arrow': true }
  : {};
---

<a href={href} {...linkProps} class="card card-link group" data-reveal>
  {
    heroImage && (
      <div class="card-media aspect-[16/9]">
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          widths={[400, 800]}
          sizes="(min-width: 768px) 400px, 100vw"
          loading={loading}
        />
      </div>
    )
  }
  <div class="card-body card-pad">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
      <time datetime={pubDate.toISOString()} class="font-mono text-[0.7rem] font-medium uppercase tracking-wide text-slate-500">
        {formattedDate}
      </time>
      <span class="flex flex-wrap justify-end gap-1">
        {category.map((c) => (
          <span class="rounded-control border border-brand/20 bg-brand/5 px-2 py-0.5 font-mono text-[0.65rem] font-medium uppercase tracking-wide text-brand">
            <FirstText text={NEWS_CATEGORY_BADGES[c]} />
          </span>
        ))}
      </span>
    </div>
    <h3 class="mt-2 font-heading text-base font-bold text-slate-900"><FirstText text={title} context="heading" /></h3>
    <p class="mt-2 card-fill text-sm text-slate-600"><FirstText text={summary} /></p>
    {
      sourceUrl && (
        <span class="mt-4 font-mono text-xs font-semibold text-brand-accent">
          {sourceName ? `via ${sourceName}` : 'Read at source'} &nearr;
        </span>
      )
    }
  </div>
</a>
