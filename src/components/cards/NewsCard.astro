---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/base';

interface Props {
  post: CollectionEntry<'news'>;
  loading?: 'eager' | 'lazy';
}

const categoryLabels: Record<string, string> = {
  refinery: 'The REFINERY',
  teams: 'Teams',
  regional: 'Regional',
  partnerships: 'Partnerships',
  'first-community': 'FIRST Community',
};

const { post, loading = 'lazy' } = Astro.props;
const { title, summary, pubDate, category, heroImage, heroImageAlt, sourceUrl, sourceName } = post.data;
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const href = sourceUrl ?? withBase(`news/${post.id}/`);
const linkProps = sourceUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} {...linkProps} class="card card-link group" data-reveal>
  {
    heroImage && (
      <div class="card-media aspect-[16/9]">
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          widths={[400, 800]}
          sizes="(min-width: 768px) 400px, 100vw"
          loading={loading}
        />
      </div>
    )
  }
  <div class="card-body card-pad">
    <div class="flex items-center justify-between gap-2">
      <time datetime={pubDate.toISOString()} class="font-mono text-[0.7rem] font-medium uppercase tracking-wide text-slate-400">
        {formattedDate}
      </time>
      <span class="rounded-control border border-brand/20 bg-brand/5 px-2 py-0.5 font-mono text-[0.65rem] font-medium uppercase tracking-wide text-brand">
        {categoryLabels[category]}
      </span>
    </div>
    <h3 class="mt-2 font-heading text-base font-bold text-slate-900">{title}</h3>
    <p class="mt-2 card-fill text-sm text-slate-600">{summary}</p>
    {
      sourceUrl && (
        <span class="mt-4 font-mono text-xs font-semibold text-brand-accent">
          {sourceName ? `via ${sourceName}` : 'Read at source'} &nearr;
        </span>
      )
    }
  </div>
</a>
