---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const { name, summary, icon, externalUrl } = app.data;
---

<a
  href={externalUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="card card-link card-pad-lg group"
  data-reveal
>
  <div class="flex items-center gap-3">
    {icon && <Image src={icon} alt="" class="h-10 w-10 rounded-media object-cover" width={40} height={40} densities={[1, 2, 3]} />}
    <h3 class="font-heading text-lg font-bold text-slate-900">{name}</h3>
  </div>
  <p class="mt-3 card-fill text-sm text-slate-600">{summary}</p>
  <span class="mt-4 font-mono text-sm font-semibold text-brand-accent group-hover:underline">Visit app &rarr;</span>
</a>
