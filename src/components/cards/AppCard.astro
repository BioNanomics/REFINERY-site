---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const { name, summary, icon, externalUrl } = app.data;
---

<a
  href={externalUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="corner-brackets group flex flex-col rounded-sm border border-slate-200 bg-white p-6 transition hover:border-brand-accent"
>
  <span class="corner-bl" aria-hidden="true"></span>
  <span class="corner-br" aria-hidden="true"></span>
  <div class="flex items-center gap-3">
    {icon && <Image src={icon} alt="" class="h-10 w-10 rounded-sm object-cover" width={40} height={40} />}
    <h3 class="font-heading text-lg font-bold text-slate-900">{name}</h3>
  </div>
  <p class="mt-3 flex-1 text-sm text-slate-600">{summary}</p>
  <span class="mt-4 font-mono text-sm font-semibold text-brand-accent group-hover:underline">Visit app &rarr;</span>
</a>
