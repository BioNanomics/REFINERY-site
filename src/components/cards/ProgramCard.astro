---
import FirstText from '../brand/FirstText.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  program: CollectionEntry<'programs'>;
}

const { program } = Astro.props;
const { title, summary, audience } = program.data;
---

<div class="card card-pad" data-reveal>
  <h3 class="font-heading text-base font-bold text-slate-900"><FirstText text={title} context="heading" /></h3>
  <p class="mt-2 text-sm text-slate-600"><FirstText text={summary} /></p>
  {
    audience.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {audience.map((a) => (
          <li class="border border-brand/20 bg-brand/5 px-2 py-0.5 font-mono text-[0.65rem] font-medium uppercase text-brand">{a}</li>
        ))}
      </ul>
    )
  }
</div>
