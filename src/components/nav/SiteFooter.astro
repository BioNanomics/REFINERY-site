---
import { Image } from 'astro:assets';
import { withBase } from '../../utils/base';
import logoFullColor from '../../assets/logo-full-color.svg';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <Image src={logoFullColor} alt="The REFINERY" class="h-8 w-auto" />
      <p class="mt-2 text-sm text-slate-600">
        Shared infrastructure for stronger robotics teams across Northeast Indiana.
      </p>
    </div>

    <div class="flex flex-col gap-2 text-sm text-slate-600 sm:items-end">
      <a href="mailto:refinery@bionanomics.com" class="hover:text-brand-accent">
        refinery@bionanomics.com
      </a>
      <a href={withBase('resources/')} class="hover:text-brand-accent">
        Documentation
      </a>
      <a href="https://tims.bionanomics.com" target="_blank" rel="noopener noreferrer" class="hover:text-brand-accent">
        TIMS
      </a>
      <a href={withBase('contact/')} class="hover:text-brand-accent">
        Contact
      </a>
      <p>&copy; {currentYear} The REFINERY. All rights reserved.</p>
    </div>
  </div>
</footer>
