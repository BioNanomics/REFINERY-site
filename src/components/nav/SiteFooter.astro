      <a href="https://tims.bionanomics.com" target="_blank" rel="noopener noreferrer" class="transition-colors duration-base ease-out-soft hover:text-brand-accent">
        TIMS
      </a>
      <a href="mailto:refinery@bionanomics.com" class="transition-colors duration-base ease-out-soft hover:text-brand-accent">
        Contact
      </a>
      <a href="https://bionanomics.com" target="_blank" rel="noopener noreferrer" class="transition-colors duration-base ease-out-soft hover:text-brand-accent">
        BioNanomics
      </a>
