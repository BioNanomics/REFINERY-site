---
import { Image } from 'astro:assets';
import logoFullColor from '../../assets/logo-full-color.svg';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-300 bg-zinc-200">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <Image src={logoFullColor} alt="The REFINERY" class="h-16 w-auto" />
      <p class="mt-3 max-w-md text-sm text-zinc-600">
        Robotics Education, Fabrication, & Innovation Nexus: Entrepreneurship for Rising Youth
      </p>
      <div class="mt-4 flex items-center gap-4 text-zinc-600">
        <a href="https://www.instagram.com/the_refinery_bybnx" target="_blank" rel="noopener noreferrer" class="transition-colors duration-base ease-out-soft hover:text-brand-accent" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <circle cx="12" cy="12" r="5" />
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="https://youtube.com/@therefinery-in" target="_blank" rel="noopener noreferrer" class="transition-colors duration-base ease-out-soft hover:text-brand-accent" aria-label="YouTube">
