---
import { Image } from 'astro:assets';
import SocialIcon from '../marketing/SocialIcon.astro';
import type { SocialKey } from '../../utils/socials';
import logoFullColor from '../../assets/logo-full-color.svg';

const currentYear = new Date().getFullYear();

/**
 * The REFINERY's own accounts. Deliberately a local list rather than the teams collection's
 * `socials` shape run through SocialLinks: these are the organization's URLs, the footer
 * styles its icons against zinc rather than slate, and the order here is the footer's own.
 * Only the glyphs are shared, via SocialIcon.
 *
 * The GitHub account is BioNanomics' — see the note in src/utils/schema.ts explaining why
 * that URL is linked here but deliberately kept out of the Organization's `sameAs`.
 */
const socials: { key: SocialKey; label: string; url: string }[] = [
  { key: 'instagram', label: 'Instagram', url: 'https://www.instagram.com/the_refinery_bybnx' },
  { key: 'youtube', label: 'YouTube', url: 'https://youtube.com/@therefinery-in' },
  { key: 'github', label: 'GitHub', url: 'https://github.com/BioNanomics' },
  { key: 'linkedin', label: 'LinkedIn', url: 'https://www.linkedin.com/company/the-refinery-robotics' },
];
---

<footer class="border-t border-zinc-300 bg-zinc-200">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <Image src={logoFullColor} alt="The REFINERY" class="h-16 w-auto" />
      <p class="mt-3 max-w-md text-sm text-zinc-600">
        Robotics Education, Fabrication, & Innovation Nexus: Entrepreneurship for Rising Youth
      </p>
      <ul class="mt-4 flex items-center gap-4 text-zinc-600">
        {socials.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              data-no-external-arrow
              class="inline-flex rounded-sm transition-colors duration-base ease-out-soft hover:text-brand-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
              aria-label={social.label}
            >
              <SocialIcon name={social.key} class="h-5 w-5" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col gap-2 text-sm text-zinc-600 sm:items-end">
      <a href="mailto:info@refineryrobotics.org" class="transition-colors duration-base ease-out-soft hover:text-brand-accent">
        info@refineryrobotics.org
      </a>
      <a
        href="mailto:info@refineryrobotics.org"
        data-contact-open="contact"
        class="transition-colors duration-base ease-out-soft hover:text-brand-accent"
      >
        Contact
      </a>
      <a href="https://bionanomics.com" target="_blank" rel="noopener noreferrer" class="transition-colors duration-base ease-out-soft hover:text-brand-accent">
        BioNanomics
      </a>
      <p>&copy; {currentYear} The REFINERY. All rights reserved.</p>
    </div>
  </div>
  <div class="border-t border-zinc-300">
    <p class="mx-auto max-w-6xl px-6 py-4 text-xs text-zinc-600">
      {/* Required disclaimer per FIRST's Policy on the Use of FIRST Trademarks and Copyrighted
          Materials (rev. 04/19/25), Section IV.A — every mark gets its own ® in this fixed
          notice, unlike the once-per-page rule elsewhere on the site. The FIRST word mark is
          italicized per Section III.A.5; FRC/FTC are separate marks and stay roman. */}
      <i class="first-mark">FIRST</i>®, <i class="first-mark">FIRST</i>® Robotics Competition, <i class="first-mark">FIRST</i>® Tech
      Challenge, FRC®, and FTC® are registered trademarks of <i class="first-mark">FIRST</i>®
      (<a href="https://www.firstinspires.org" target="_blank" rel="noopener noreferrer" class="underline hover:text-brand-accent">www.firstinspires.org</a>),
      which is not overseeing, involved with, or responsible for this activity, product, or service.
    </p>
  </div>
</footer>
