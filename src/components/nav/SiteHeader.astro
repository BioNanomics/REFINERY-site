---
import { Image } from 'astro:assets';
import { withBase } from '../../utils/base';
import logoFullColor from '../../assets/logo-full-color.svg';

const navLinks = [
  { label: 'Home', href: withBase('/') },
  { label: 'What We Do', href: withBase('what-we-do/') },
  { label: 'Programs & Events', href: withBase('programs-events/') },
  { label: 'News', href: withBase('news/') },
  { label: 'Get Involved', href: withBase('get-involved/') },
  { label: 'About', href: withBase('about/') },
];

const currentPath = Astro.url.pathname;

/**
 * What aria-current (if any) a nav entry should carry, and — since it returns undefined for
 * "not here" — whether to style it as active.
 *
 * Previously this was `currentPath === link.href`, which only ever matched the six top-level
 * pages. Reading an article at /news/an-article/ left the whole nav inactive, so the one place
 * a reader is most likely to have followed a link in from outside was also the place the nav
 * stopped telling them where they were. Section matching fixes that.
 *
 * 'page' for the exact URL, 'true' for an ancestor section — ARIA reserves 'page' for the
 * current page itself, so a section ancestor must not claim it.
 *
 * Home is special-cased: every path starts with '/', so an ancestor test would light it up
 * everywhere. The trailing slash is normalised because withBase() only strips LEADING slashes
 * (see src/utils/base.ts), so a request served as /about rather than /about/ still matches.
 */
function navCurrent(href: string): 'page' | 'true' | undefined {
  const home = withBase('/');
  if (href === home) return currentPath === home ? 'page' : undefined;

  const exact = href.replace(/\/$/, '');
  if (currentPath === exact || currentPath === `${exact}/`) return 'page';
  return currentPath.startsWith(`${exact}/`) ? 'true' : undefined;
}
---

<header class="sticky top-0 z-40 border-b-2 border-brand-accent-fill bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
    <a href={withBase('/')} class="shrink-0">
      <Image src={logoFullColor} alt="The REFINERY" class="h-12 w-auto" loading="eager" />
    </a>

    <div class="hidden h-8 w-px bg-slate-200 lg:block" aria-hidden="true"></div>

    <nav aria-label="Primary" class="hidden flex-1 items-stretch gap-0.5 lg:flex">
      {
        navLinks.map((link, index) => {
          const current = navCurrent(link.href);
          const isActive = current !== undefined;
          return (
            <a
              href={link.href}
              aria-current={current}
              class:list={[
                'group flex flex-col items-start justify-center gap-0.5 px-2.5 py-1.5 transition-colors',
                isActive ? 'text-brand-accent' : 'text-slate-600 hover:text-brand',
              ]}
            >
              <span class="font-mono text-[0.65rem] text-slate-500 group-hover:text-brand-accent">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="flex items-center gap-1 whitespace-nowrap text-sm font-semibold">
                {link.label}
                <span
                  class:list={[
                    'h-0.5 w-3 bg-brand-accent-fill transition-transform duration-base ease-out-soft',
                    isActive ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
                  ]}
                  aria-hidden="true"
                />
              </span>
            </a>
          );
        })
      }
    </nav>

    <div class="hidden shrink-0 items-center gap-4 lg:flex">
      <a
        href={withBase('donate/')}
        class="rounded-control border-2 border-brand bg-brand px-4 py-2 text-sm font-semibold text-brand-light transition duration-base ease-out-soft hover:bg-white hover:text-brand-accent"
      >
        Donate
      </a>
    </div>

    <details class="shrink-0 lg:hidden">
      <summary class="eyebrow-tag cursor-pointer list-none text-brand">Menu</summary>
      <nav aria-label="Primary mobile" class="absolute left-0 right-0 top-full flex flex-col gap-1 border-b-2 border-brand-accent-fill bg-white px-6 pb-4">
        {
          navLinks.map((link, index) => {
            const current = navCurrent(link.href);
            return (
              <a
                href={link.href}
                aria-current={current}
                class:list={[
                  'flex items-center gap-2 py-2 text-sm font-medium',
                  current ? 'text-brand-accent' : 'text-slate-600 hover:text-brand-accent',
                ]}
              >
                <span class="font-mono text-[0.65rem] text-slate-500">{String(index + 1).padStart(2, '0')}</span>
                {link.label}
              </a>
            );
          })
        }
        <a href={withBase('donate/')} class="py-2 text-sm font-semibold text-brand-accent">
          Donate
        </a>
      </nav>
    </details>
  </div>
</header>
