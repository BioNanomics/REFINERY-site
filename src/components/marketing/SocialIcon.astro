---
/**
 * Social-platform glyphs.
 *
 * Deliberately separate from Icon.astro, which declares a single coherent line-art system
 * (`fill="none" stroke="currentColor" stroke-width="1.6"`) for marks this project drew
 * itself. Eight of the ten glyphs here are solid fills with no stroke, and two want a
 * different stroke weight — folding them into Icon.astro would mean per-icon attribute
 * overrides, which dissolves the one invariant that makes that file coherent.
 *
 * They also differ in kind, not just in style: Icon.astro's marks are ours to restyle at
 * will, while these are third-party trademarks reproduced under each platform's own brand
 * guidelines. Keeping them in their own file makes that boundary legible. The two files
 * share a mechanism (a name -> markup record rendered via set:html) so they stay siblings.
 *
 * Stroke-based glyphs carry their own stroke attributes on the outer <svg>; fill-based ones
 * set fill="currentColor" and no stroke.
 *
 * Consumed by SocialLinks (team cards and team pages), SiteFooter, and PeopleBios — so a
 * platform's mark is drawn once for the whole site rather than pasted per call site.
 */
import type { SocialKey } from '../../utils/socials';

interface Props {
  name: SocialKey;
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;

/** Glyphs drawn with strokes rather than fills — they need the stroke attribute set. */
const STROKED: ReadonlySet<SocialKey> = new Set(['instagram', 'website']);

const icons: Record<SocialKey, string> = {
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>',
