---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;

const styles = {
  primary: 'bg-brand-accent text-brand-light border-brand-accent hover:brightness-110',
  secondary: 'bg-white text-brand border-brand hover:bg-slate-100',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-control border-2 px-6 py-3 text-sm font-semibold transition duration-base ease-out-soft hover:-translate-y-0.5 hover:shadow-card-hover active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent',
    styles[variant],
  ]}
>
  {/* The label lives in one span so it stays a single flex item. Labels that contain inline
      markup — the italic <First /> mark, for instance — would otherwise split into separate
      flex items and lose the spaces around them. */}
  <span><slot /></span>
</a>
