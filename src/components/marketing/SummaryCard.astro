---
import Icon, { type IconName } from './Icon.astro';
import FirstText from '../brand/FirstText.astro';

interface Props {
  title: string;
  description: string;
  /**
   * Omit to render a plain, non-interactive card. Used where a group of cards
   * would all point at the same destination as a CTA button beside them — the
   * button is the single path, and a card offering the same jump is noise.
   */
  href?: string;
  cta?: string;
  /** Short status label shown beside the title — e.g. a beta/in-progress note. */
  status?: string;
  icon?: IconName;
  offset?: boolean;
  class?: string;
}

const { title, description, href, cta = 'Explore', status, icon, offset = false, class: className } = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={['card card-pad-lg', href && 'card-link group', { 'sm:mt-8': offset }, className]}
  data-reveal
>
  {
    icon && (
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-control bg-brand-accent/10 text-brand-accent">
        <Icon name={icon} class="h-5 w-5" />
      </div>
    )
  }
  <div class="flex flex-wrap items-center gap-2">
    <h3 class="font-heading text-lg font-bold text-slate-900"><FirstText text={title} context="heading" /></h3>
    {status && <span class="status-tag">{status}</span>}
  </div>
  <p class="mt-2 card-fill text-sm text-slate-600"><FirstText text={description} /></p>
  {
    href && (
      <span class="mt-4 font-mono text-sm font-semibold text-brand-accent group-hover:underline">{cta} &rarr;</span>
    )
  }
</Tag>
