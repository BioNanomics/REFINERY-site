---
/**
 * A long-form page section: heading in a left rail, content on the right. Collapses to a
 * single column below lg (see .section-split in marketing.css).
 *
 * The rail sticks while its section scrolls past, so on a page of many sections the reader
 * always knows which one they're in. The offset clears the sticky site header.
 *
 * Pass the heading as `title`, or use the `title` slot when it carries markup (e.g. a
 * <First /> mark). `rule` draws the hairline above the section; leave it off for the first
 * section under a PageHeader, which already supplies the gap.
 */
interface Props {
  id?: string;
  title?: string;
  rule?: boolean;
  loose?: boolean;
}

const { id, title, rule = true, loose = false } = Astro.props;
---

<section id={id} class:list={['scroll-mt-6', 'section', rule && 'section-rule', loose && 'section-loose']}>
  <div class="section-inner section-split">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="font-heading text-3xl font-bold leading-tight text-slate-900 text-balance sm:text-4xl" data-reveal>
        {title ?? <slot name="title" />}
      </h2>
    </div>
    <div class="flex max-w-2xl flex-col gap-4 text-lg text-slate-700">
      <slot />
    </div>
  </div>
</section>
