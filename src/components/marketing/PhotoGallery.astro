---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A grid of photos for the body of a news story. Each photo carries its own alt text, which is
// required for the same reason heroImageAlt is: an image with nothing to say about it should be
// left out, not rendered with alt="".
//
// Every tile is cropped to 3:4, the shape most phone photos already are, so a landscape or
// unusually tall shot doesn't break the grid's rows. The ratio is inline rather than a utility
// class because <Image> emits width/height attributes, and those must lose to an explicit ratio.
interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}

const { photos } = Astro.props;
---

<ul class="not-prose my-10 grid grid-cols-2 gap-3 sm:grid-cols-3" data-reveal>
  {
    photos.map((photo) => (
      <li>
        <Image
          src={photo.src}
          alt={photo.alt}
          class="h-auto w-full rounded-card object-cover shadow-card"
          style="aspect-ratio: 3 / 4"
          widths={[300, 600]}
          sizes="(min-width: 768px) 250px, 50vw"
        />
      </li>
    ))
  }
</ul>
