---
interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav aria-label="Section navigator" class="overflow-x-auto border-b border-slate-200 bg-slate-50">
  <ul class="mx-auto flex max-w-6xl gap-1 px-6 whitespace-nowrap">
    {
      sections.map((s, i) => (
        <li>
          <a
            href={`#${s.id}`}
            class="flex flex-col gap-0.5 px-3 py-2.5 text-sm font-medium text-slate-600 transition-colors hover:text-brand-accent"
          >
            <span class="font-mono text-[0.6rem] text-slate-400">{String(i + 1).padStart(2, '0')}</span>
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
