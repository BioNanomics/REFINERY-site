---
import FirstText from '../brand/FirstText.astro';

/**
 * A list separated by hairlines instead of boxes or left-border chips. Two columns from sm up
 * by default; pass columns={1} for items long enough to want the full measure, or 3 for short
 * ones (names) in a wide column.
 */
interface Props {
  items: readonly string[];
  columns?: 1 | 2 | 3;
}

const { items, columns = 2 } = Astro.props;
---

<ul class:list={['grid grid-cols-1 gap-x-10', columns === 2 && 'sm:grid-cols-2', columns === 3 && 'sm:grid-cols-2 xl:grid-cols-3']} data-reveal>
  {items.map((item) => <li class="border-t border-slate-300 py-3 text-base text-slate-700"><FirstText text={item} /></li>)}
</ul>
