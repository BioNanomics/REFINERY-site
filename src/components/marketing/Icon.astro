---
export type IconName =
  | 'launch'
  | 'funding'
  | 'parts'
  | 'tools'
  | 'facilities'
  | 'training'
  | 'community'
  | 'robot'
  | 'kit'
  | 'clipboard'
  | 'map-pin';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

// Simple line-art marks built from primitive shapes (circle/rect/line/polygon)
// rather than freehand curves, so they stay legible at small sizes and match
// the site's existing hand-drawn social/LinkedIn icon style.
const icons: Record<IconName, string> = {
  launch: '<line x1="12" y1="19" x2="12" y2="5"/><polyline points="6,11 12,5 18,11"/>',
  funding:
    '<circle cx="12" cy="12" r="9"/><text x="12" y="16.5" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor" stroke="none">$</text>',
  parts: '<polygon points="12,3 19,7.5 19,16.5 12,21 5,16.5 5,7.5"/><circle cx="12" cy="12" r="2.3"/>',
  // Open-end wrench, drawn as a closed silhouette rather than thin strokes —
  // stroked outlines of tools (screwdrivers, crossed wrench pairs, calipers)
  // all turned to mush at the 20px size these actually render at.
  // The 1.3 scale makes the rotated shape fill the box; stroke-width is
  // pre-divided by that scale so it still renders at the 1.6 the other
  // icons use instead of a heavier 2.08.
  tools:
    '<g transform="rotate(-45 12 12) translate(12 12) scale(1.3) translate(-12 -12)" stroke-width="1.23"><path d="M8 3.5h2.5v3.2h3v-3.2H16v6.3h-1.8v10.5h-4.4V9.8H8z"/></g>',
  // Shop building with a roll-up bay door. The previous version drew the
  // door as two bare verticals, which read as columns — i.e. a bank or
  // courthouse — rather than a workshop.
  facilities:
    '<polyline points="3,10 12,4 21,10"/><line x1="5" y1="10" x2="5" y2="20"/><line x1="19" y1="10" x2="19" y2="20"/><line x1="3.5" y1="20" x2="20.5" y2="20"/><rect x="8.5" y="13" width="7" height="7" rx="0.8"/>',
  // Lightbulb drawn as one continuous silhouette (glass + shoulders) over
  // a stacked base. The previous version was a bare circle with a
  // disconnected stem floating above it.
  training:
    '<path d="M8.5 13.5a5 5 0 1 1 7 0c-.8.8-1.2 1.4-1.3 2.5h-4.4c-.1-1.1-.5-1.7-1.3-2.5z"/><line x1="9.8" y1="18.5" x2="14.2" y2="18.5"/><line x1="10.5" y1="21" x2="13.5" y2="21"/>',
  community:
    '<circle cx="9" cy="9" r="3"/><circle cx="16.5" cy="10" r="2.3"/><path d="M4 20a5 6 0 0 1 10 0"/><path d="M13.7 20a4.2 5 0 0 1 6.3-4.4"/>',
  robot:
    '<rect x="6" y="8" width="12" height="10" rx="2"/><circle cx="9.5" cy="12.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="14.5" cy="12.5" r="1.2" fill="currentColor" stroke="none"/><line x1="12" y1="8" x2="12" y2="4"/><circle cx="12" cy="3" r="1" fill="currentColor" stroke="none"/>',
  kit: '<polygon points="12,3 20,7.5 20,16.5 12,21 4,16.5 4,7.5"/><polyline points="4,7.5 12,12 20,7.5"/><line x1="12" y1="12" x2="12" y2="21"/>',
  clipboard:
    '<rect x="6" y="4" width="12" height="17" rx="2"/><rect x="9" y="2" width="6" height="3" rx="1"/><line x1="8.5" y1="10" x2="15.5" y2="10"/><line x1="8.5" y1="14" x2="15.5" y2="14"/><line x1="8.5" y1="18" x2="12.5" y2="18"/>',
  'map-pin': '<path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.3"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icons[name]}
/>
