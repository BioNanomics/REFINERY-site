---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CTAButton from './CTAButton.astro';
import FirstText from '../brand/FirstText.astro';
import { withBase } from '../../utils/base';
import { firstPlain } from '../../utils/first';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
  image: ImageMetadata;
  imageAlt: string;
}

const {
  eyebrow,
  title,
  description,
  ctaLabel = 'Get Involved',
  ctaHref = withBase('get-involved/'),
  image,
  imageAlt,
} = Astro.props;
---

<section class="relative overflow-hidden pt-6 pb-10 lg:py-12">
  {/* Text column aligns to the shared 72rem container; the photo runs off the right edge
      of the viewport and fills the hero's full height. Stacks photo-first below lg. */}
  <div class="grid grid-cols-1 lg:grid-cols-2">
    <div
      class="flex flex-col items-start justify-center gap-6 px-6 py-10 sm:py-12 lg:py-14 lg:pr-12 lg:pl-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))]"
      data-reveal-group
    >
      {eyebrow && <p class="eyebrow-tag text-brand-accent" data-reveal><FirstText text={eyebrow} context="heading" /></p>}
      <h1
        class="font-heading text-6xl font-extrabold leading-[0.9] tracking-tight text-slate-900 text-balance sm:text-7xl lg:text-[clamp(4rem,5.6vw,6rem)]"
        data-reveal
      >
        <FirstText text={title} context="heading" />
      </h1>
      <p class="max-w-md text-lg text-slate-600" data-reveal><FirstText text={description} /></p>
      <div class="flex flex-wrap items-center gap-3" data-reveal>
        <CTAButton href={ctaHref}>{ctaLabel}</CTAButton>
        <slot name="actions" />
      </div>
      <slot name="footnote" />
    </div>

    <div class="order-first lg:order-none" data-reveal>
      <Image
        src={image}
        alt={firstPlain(imageAlt)}
        class="aspect-[4/3] h-full w-full object-cover lg:aspect-auto lg:rounded-l-card"
        widths={[640, 960, 1400]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
