---
/**
 * The FIRST® wordmark in running copy. Program names are written as the mark plus plain
 * text — `<First /> Robotics Competition` — which puts the ® exactly where the guidelines
 * want it: FIRST® Robotics Competition.
 */
import FirstText from './FirstText.astro';
import type { FirstContext, FirstToken } from '../../utils/first';

interface Props {
  token?: FirstToken;
  context?: FirstContext;
  reg?: boolean;
}

const { token = 'FIRST', context = 'body', reg } = Astro.props;
---
<FirstText text={token} context={context} reg={reg} />
