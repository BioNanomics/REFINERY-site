---
/**
 * Renders arbitrary copy with FIRST® / FRC® / FTC® / LEGO® trademarks styled per FIRST's
 * trademark policy. Use this for strings that arrive as props — content-collection
 * frontmatter, card labels, section headings — where the author can't wrap the mark
 * themselves. Markdown and MDX bodies are handled by rehype-first-marks.mjs instead.
 */
import { tokenizeFirst, claimRegisteredMark, type FirstContext } from '../../utils/first';

interface Props {
  text: string;
  /** Headings and body copy each earn their own first-use ® (guidelines p. 8). */
  context?: FirstContext;
  /** Force or suppress the ® when document render order needs overriding. */
  reg?: boolean;
}

const { text, context = 'body', reg } = Astro.props;

const segments = tokenizeFirst(text).map((segment) => {
  if (segment.type !== 'mark') return { ...segment, registered: false };
  const claimed = claimRegisteredMark(Astro.locals.firstMarks, segment.token!, context);
  return { ...segment, registered: reg ?? claimed };
});
---
{
  segments.map((segment) =>
    segment.type === 'mark' ? (
      /* Only the word "FIRST" is italicized; FRC, FTC, and LEGO are separate marks that
         stay all caps and roman. */
      <Fragment>{segment.token === 'FIRST' ? <i class="first-mark">{segment.value}</i> : segment.value}{segment.registered && <sup class="first-reg">®</sup>}</Fragment>
    ) : (
      segment.value
    ),
  )
}
