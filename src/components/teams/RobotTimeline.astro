---
/**
 * The team's robots, newest season first.
 *
 * Naming a robot is a thing FIRST teams genuinely care about, and it is the detail that
 * makes a profile read as a team's page rather than a directory entry. Season and game are
 * shown alongside because a robot name alone doesn't place it in time.
 *
 * FIRST game names ("Into the Deep", "Rebuilt") are marks in their own right, but they are
 * NOT in FIRST_TOKENS — see src/utils/first.ts — so they render exactly as authored rather
 * than picking up a ® from FirstText. That is correct: the trademark policy this repo
 * implements covers the FIRST word mark and the program names, not the season titles.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  robots: CollectionEntry<'teams'>['data']['robots'];
}

const { robots } = Astro.props;

// Newest first. A copy, so the sort never reorders the caller's array.
const ordered = [...robots].sort((a, b) => b.year - a.year);
---

<ol class="mt-6 space-y-6" data-reveal-group>
  {
    ordered.map((robot) => (
      <li class="flex flex-col gap-4 sm:flex-row sm:gap-6" data-reveal>
        {/* The year rail matches AwardsList, so the two sections line up down the page. */}
        <p class="shrink-0 font-mono text-sm font-bold text-slate-900 sm:w-16 sm:pt-0.5">
          {robot.year}
        </p>
        <div class="flex-1">
          <h3 class="font-heading text-base font-bold text-slate-900">{robot.name}</h3>
          {robot.game && <p class="mt-0.5 font-mono text-xs text-slate-500">{robot.game}</p>}
          {robot.description && <p class="mt-2 text-sm text-slate-600">{robot.description}</p>}
          {/* imageAlt is schema-optional, so a missing one degrades to decorative rather
              than to the filename a screen reader would otherwise announce. */}
          {robot.image && (
            <Image
              src={robot.image}
              alt={robot.imageAlt ?? ''}
              widths={[400, 800]}
              sizes="(min-width: 640px) 400px, 100vw"
              class="card-media mt-3 w-full max-w-md"
            />
          )}
        </div>
      </li>
    ))
  }
</ol>
