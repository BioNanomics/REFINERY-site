---
/**
 * The banner band at the top of a team page, with the team's identity plaque overlapping
 * its lower-left corner.
 *
 * The band is either the team's `banner` photograph or, until one is supplied, a brand-navy
 * panel carrying the site's own grid texture. Deliberately NOT
 * public/images/placeholders/hero-placeholder.svg — that gradient is the site's marker for
 * "real photography pending" and reads as an unfinished page, where a panel built from the
 * site's own texture reads as a design decision. See docs/placeholder-images.md for the
 * photography terms this has to live within, including the download-not-hotlink rule.
 *
 * The plaque sits in NORMAL FLOW with a negative top margin rather than being absolutely
 * positioned, and that is what makes the overlap safe: the part hanging below the band still
 * occupies layout height, so the heading underneath is pushed clear on its own instead of
 * needing hand-tuned clearance that would drift the moment the logo size changed.
 *
 * The white ground is not decoration either. Team logos are transparent artwork drawn for a
 * white page, and they range from near-white wordmarks to dark navy badges — dropping them
 * straight onto a navy band makes roughly half of them illegible. A plaque gives every one
 * of the fourteen the background it was designed for, with no per-team overrides.
 *
 * The band's aspect ratio is the photo's own, uncropped, down to a floor of 5:3 — a group
 * photo shot at 5:3 or wider (a typical landscape frame) shows in full with no crop at all.
 * Only a photo taller than that, where showing it in full would make the band uncomfortably
 * tall (a near-square group shot is the common case: subjects run nearly its full height),
 * gets clamped to the 5:3 floor and `object-cover`-cropped down to it — pick which end
 * survives with `banner.focalPoint` (see the field's comment in content.config.ts). The floor
 * is one fixed ratio at every viewport width, not a separate mobile/desktop pair, so a single
 * `focalPoint` value stays correct everywhere it applies.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { firstPlain } from '../../utils/first';

interface Props {
  team: CollectionEntry<'teams'>;
}

const { team } = Astro.props;
const { name, logo, banner } = team.data;

// Never let the band go taller than 5:3, but never force a wider photo down to it either —
// `object-cover` only crops the axis where the box is smaller than the source, so a ratio
// above the floor renders as a no-op crop.
const MIN_BANNER_RATIO = 5 / 3;
const bannerAspectRatio = banner
  ? Math.max(banner.image.width / banner.image.height, MIN_BANNER_RATIO)
  : undefined;

// Fed to the credit's flex-row-reverse/wrap-reverse layout below in reverse order, so the
// browser's normal greedy line-fill (which always maxes out the FIRST line it lays out)
// maxes out the line ending in the credit's last word instead — see the comment at the
// credit markup for how that turns into "fullest line at the bottom" on screen.
// firstPlain expands FRC/FTC to their full program names and appends a ® to FIRST-owned
// marks — the credit can't hold the italicized <FirstText /> markup since it's split into
// individual words below, so this is the plain-text path other unmarked-up spots (alt text,
// meta tags) already use.
const creditWords = banner ? firstPlain(banner.credit.text).trim().split(/\s+/).reverse() : [];
---

{/* --team-plaque-h is the single source for both the plaque's height and how far it rides
    up onto the band. The overlap is expressed as calc(h / -3) rather than a second hand-
    picked value, so "overlaps by a third of its own height" stays true by construction
    instead of by two numbers someone has to remember to keep in step. */}
<div class="[--team-plaque-h:6rem] sm:[--team-plaque-h:9rem]">
  {/* -mx-6 bleeds the band out past the section's own 1.5rem inline padding — the same
      1.5rem, so on a narrow viewport it runs edge-to-edge, and on wider ones it overhangs
      the plaque and heading below by a consistent amount rather than lining up flush with
      them. Only this wrapper bleeds; the plaque and heading stay within the section. */}
  <div class="relative -mx-6">
    {
      banner ? (
        <div
          class="card-media relative w-full overflow-hidden bg-brand"
          style={{ aspectRatio: bannerAspectRatio }}
        >
          <Image
            src={banner.image}
            alt={firstPlain(banner.alt)}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1024px) 832px, 100vw"
            loading="eager"
            class="h-full w-full object-cover"
            style={banner.focalPoint ? { objectPosition: banner.focalPoint } : undefined}
          />
          {/* Overlaid bottom-RIGHT, diagonally opposite the plaque, so the credit can never
              collide with it at any viewport width. Kept on the image rather than moved
              below the band because the permission this photography is used under depends
              on attribution a reader can actually see.

              max-w-[60%] is what actually keeps that promise on a narrow viewport: the
              plaque wrapper below is a fixed w-2/5 (40%) of this same band, so capping the
              credit to the remaining 60% reserves it a column the plaque can never reach
              into, no matter how long a team's credit text is or how narrow the screen gets.
              Left free to wrap (rather than truncated) it grows upward from `bottom-2`
              instead of sideways, so full attribution always stays readable.

              The normal CSS line-break algorithm always fills the FIRST line as full as
              possible and dumps whatever's left on the last one — for right-aligned text
              anchored to a bottom corner, that puts a short line hard against the plaque and
              a mostly-empty one dangling above it. flex-row-reverse + flex-wrap-reverse on
              `creditWords` (already reversed in the frontmatter) inverts both axes at once:
              feeding words last-to-first means the greedy algorithm's "first, fullest" line
              ends up holding the credit's LAST words, and wrap-reverse then places that line
              at the bottom instead of the top — so the fullest line is the one nearest
              `bottom-2`, and only the minimum overflow spills onto the line above it. Each
              word is its own flex item (`gap-x` stands in for the word spaces line-splitting
              would otherwise collapse), and `justify-start` reads as right-aligned here
              specifically because row-reverse already flipped which edge "start" is. */}
          <p class="absolute bottom-2 right-3 max-w-[60%] font-mono text-[0.65rem] text-white/85 [text-shadow:0_1px_2px_rgb(0_0_0/0.6)]">
            {banner.credit.url ? (
              <a
                href={banner.credit.url}
                target="_blank"
                rel="noopener noreferrer"
                data-no-external-arrow
                class="flex flex-row-reverse flex-wrap-reverse justify-start gap-x-[0.3em] hover:text-white hover:underline"
              >
                {creditWords.map((word) => (
                  <span>{word}</span>
                ))}
              </a>
            ) : (
              <span class="flex flex-row-reverse flex-wrap-reverse justify-start gap-x-[0.3em]">
                {creditWords.map((word) => (
                  <span>{word}</span>
                ))}
              </span>
            )}
          </p>
        </div>
      ) : (
        <div class="card-media relative h-24 overflow-hidden bg-brand sm:h-32">
          {/* text-white/[0.09] drives the texture's currentColor. Lighter than the
              page-level texture (brand navy at 5.5%) because it sits on navy rather than
              under it. */}
          <div class="grid-texture pointer-events-none absolute inset-0 text-white/[0.09]" aria-hidden="true" />
        </div>
      )
    }
  </div>

  {/* The wrapper spans two fifths of the band and left-aligns its child, so the plaque's own
      left edge sits flush with the heading's below — the band itself bleeds past both (see
      the -mx-6 above), so the plaque no longer collides with a square corner even at a full
      third of its height overlapping the photo. The plaque itself shrinks to fit its logo
      rather than filling that space, so a square badge gets a narrow plaque and a wide
      wordmark a wider one, both anchored to that same left edge.

      `max-w-full` on the plaque is what stops a very wide mark overflowing past the band's
      right edge: it can grow to the wrapper's width and no further. Note that tightening the
      wrapper also tightens that ceiling — on a narrow viewport the widest wordmarks are
      clamped by it rather than by their own height.

      The logo's aspect ratio is never touched. Only the height is constrained (`max-h`);
      width stays `auto`, so a replaced element scales proportionally, and `object-contain`
      guards the case where `max-w-full` binds first on an unusually wide mark. Nothing here
      can stretch a team's logo.

      Staying in normal flow with a negative margin, rather than absolute positioning, is
      what keeps the overhang safe: the part below the band still occupies layout height, so
      the heading underneath is pushed clear on its own instead of needing hand-tuned
      clearance that would drift the moment the plaque resized.

      `relative z-10` is load-bearing, not habit. The band above is positioned (it needs
      `relative` to anchor the texture layer and the photo credit), and a positioned element
      paints ABOVE non-positioned in-flow content no matter which came first in the DOM — so
      without this the band covers the overlapping part and the logo appears to sit UNDER
      the banner, clipped at its bottom edge. */}
  {
    /* Gated on the logo as a whole, wrapper included — an empty plaque says nothing, and
       leaving the wrapper behind would keep its negative margin and drag the heading up
       onto the band. A team with no logo simply gets the band; the eyebrow and <h1> below
       already identify it by program, number and name.

       Also gated on banner.logoInBanner: when the banner photo already carries the team's
       mark (a pit banner graphic, rather than event photography of the team), a second copy
       in the plaque is pure duplication. `logo` itself stays populated in that case — this
       only turns off the plaque, not the schema.org metadata the page still feeds from it. */
    logo && !banner?.logoInBanner && (
      <div class="relative z-10 mt-[calc(var(--team-plaque-h)/-3)] flex w-2/5 justify-start">
        <div class="flex h-[var(--team-plaque-h)] max-w-full items-center justify-center rounded-media bg-white px-4 shadow-float sm:px-6">
          <Image
            src={logo}
            alt={`${name} logo`}
            widths={[200, 400]}
            sizes="(min-width: 640px) 260px, 30vw"
            loading="eager"
            class="max-h-[70%] w-auto max-w-full object-contain"
          />
        </div>
      </div>
    )
  }
</div>
