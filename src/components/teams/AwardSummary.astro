---
/**
 * A tally row above the full award list — "12 Winning Alliances, 6 Autonomous Awards" — so a
 * reader gets the shape of a long record (T.H.R.U.S.T.'s runs 60+ entries) before scrolling
 * a year-by-year list to find it themselves. Purely a different view of the same `awards`
 * the list below renders; see src/utils/awards.ts's summarizeAwards() for the grouping.
 */
import { summarizeAwards, type TeamAward } from '../../utils/awards';

interface Props {
  awards: TeamAward[];
}

const { awards } = Astro.props;
const summary = summarizeAwards(awards);

// The tile's background is a solid color-mix, not an alpha tint (bg-brand/10 or similar):
// this renders directly on the page's fixed grid-texture layer (MarketingLayout.astro), and
// a translucent fill lets each faint grid line bleed through unevenly — visible as a slight
// blotchiness across the tile. Mixing against --color-page (that layer's own opaque
// backdrop) instead of leaving it to composite at render time gives the same light tint with
// a uniform, solid result regardless of what's behind it.
---

<ul class="mt-4 flex flex-wrap gap-2" data-reveal>
  {
    summary.map((entry) => (
      <li class="rounded-control border border-brand/20 bg-[color-mix(in_srgb,var(--color-brand)_10%,var(--color-page))] px-3 py-1 text-sm text-brand">
        <span class="font-mono font-bold">{entry.count}</span> {entry.label}
      </li>
    ))
  }
</ul>
