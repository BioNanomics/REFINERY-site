---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import EventCard from '../components/cards/EventCard.astro';
import ProgramCard from '../components/cards/ProgramCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events', ({ data }) => !data.draft);
const upcomingEvents = allEvents.sort((a, b) => a.data.dateStart.valueOf() - b.data.dateStart.valueOf());
const featuredEvents = upcomingEvents.filter((e) => e.data.featured);

const allPrograms = await getCollection('programs', ({ data }) => !data.draft);

// Public REFINERY events calendar — managed directly in Google Calendar, not
// in the `events` content collection. Featured events (above) still come
// from `events` since those need their own detail pages/registration CTAs.
const GOOGLE_CALENDAR_ID = 'c_e4ec5bdacbab2baa6d08664ad32fc45136f38c763f265b9fdd1f9dc24bb2085f@group.calendar.google.com';
const GOOGLE_CALENDAR_TZ = 'America/Indiana/Indianapolis';
const calendarEmbedUrl = `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(GOOGLE_CALENDAR_ID)}&ctz=${encodeURIComponent(GOOGLE_CALENDAR_TZ)}`;
const calendarSubscribeUrl = `https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(GOOGLE_CALENDAR_ID)}`;
---

<MarketingLayout
  title="Programs & Events"
  description="Upcoming events, ongoing programs, and featured happenings from The REFINERY."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading eyebrow="Programs & Events" title="Get involved with what's happening" align="left" />
  </section>

  {
    featuredEvents.length > 0 && (
      <section class="border-t border-slate-100 bg-slate-50 py-16">
        <div class="mx-auto max-w-6xl px-6">
          <SectionHeading eyebrow="Featured" title="Featured Events" align="left" />
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredEvents.map((event) => <EventCard event={event} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading eyebrow="Calendar" title="Upcoming Events" align="left" />
    <div class="corner-brackets relative mt-8 overflow-hidden rounded-sm border border-slate-200">
      <span class="corner-bl" aria-hidden="true"></span>
      <span class="corner-br" aria-hidden="true"></span>
      <iframe
        src={calendarEmbedUrl}
        title="The REFINERY events calendar"
        class="h-[600px] w-full"
        style="border: 0"
        loading="eager"
      />
    </div>
    <a
      href={calendarSubscribeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-block font-mono text-sm font-semibold text-brand-accent hover:underline"
    >
      Add to your Google Calendar &nearr;
    </a>
  </section>

  <section class="border-t border-slate-100 bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeading eyebrow="Ongoing" title="Ongoing Programs" align="left" />
      {
        allPrograms.length > 0 ? (
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {allPrograms.map((program) => <ProgramCard program={program} />)}
          </div>
        ) : (
          <p class="mt-8 text-sm text-slate-500">No programs posted yet — check back soon.</p>
        )
      }
    </div>
  </section>
</MarketingLayout>
