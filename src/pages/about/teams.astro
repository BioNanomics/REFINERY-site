---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import SectionHeading from '../../components/marketing/SectionHeading.astro';
import TeamCard from '../../components/cards/TeamCard.astro';
import { getCollection } from 'astro:content';

const teams = await getCollection('teams', ({ data }) => !data.draft);
---

<MarketingLayout
  title="Meet the Teams"
  description="FRC and FTC teams supported by The REFINERY across Northeast Indiana."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading eyebrow="About" title="Meet the Teams" align="left" />
    {
      teams.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {teams.map((team) => <TeamCard team={team} />)}
        </div>
      ) : (
        <p class="mt-10 text-sm text-slate-500">Team directory coming soon.</p>
      )
    }
  </section>
</MarketingLayout>
