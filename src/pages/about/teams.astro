---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import SectionHeading from '../../components/marketing/SectionHeading.astro';
import TeamCard from '../../components/cards/TeamCard.astro';
import First from '../../components/brand/First.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/base';

const allTeams = await getCollection('teams', ({ data }) => !data.draft);
const sortByNumber = (a: (typeof allTeams)[number], b: (typeof allTeams)[number]) =>
  Number(a.data.number) - Number(b.data.number);
const frcTeams = allTeams.filter((t) => t.data.program === 'FRC').sort(sortByNumber);
const ftcTeams = allTeams.filter((t) => t.data.program === 'FTC').sort(sortByNumber);
---

<MarketingLayout
  title="FRC & FTC Teams in Northeast Indiana"
  description="FIRST Robotics Competition and FIRST Tech Challenge teams supported by The REFINERY across Northeast Indiana."
  breadcrumbs={[
    { label: 'Home', href: withBase('/') },
    { label: 'About', href: withBase('about/') },
    { label: 'Meet the Teams' },
  ]}
>
  <section class="section-tight section">
    <div class="section-inner">
      <SectionHeading as="h1" eyebrow="About" title="Meet the Teams" align="center" />
      {
        allTeams.length === 0 && (
          <p class="mt-10 text-center text-sm text-slate-500">Team directory coming soon.</p>
        )
      }
      {/* mx-auto + text-center so this sits under the centered heading rather than flush left,
          matching the intro-paragraph pattern on /donate/. */}
      <p class="mx-auto mt-4 max-w-2xl text-center text-slate-600" data-reveal>
        Looking for a team for your student, or want to start one where there isn't one yet?{' '}
        <a href={withBase('get-involved/')} class="text-brand-accent hover:underline">Get involved</a>.
      </p>
    </div>
  </section>

  {
    frcTeams.length > 0 && (
      <section class="section">
        <div class="section-inner">
          <h2 class="font-heading text-xl font-bold text-slate-900" data-reveal><First context="heading" /> Robotics Competition</h2>
          <div class="mt-6 grid grid-cols-1 items-start gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
            {frcTeams.map((team) => <TeamCard team={team} />)}
          </div>
        </div>
      </section>
    )
  }

  {
    ftcTeams.length > 0 && (
      <section class="section-rule section-loose section">
        <div class="section-inner">
          <h2 class="font-heading text-xl font-bold text-slate-900" data-reveal><First context="heading" /> Tech Challenge</h2>
          <div class="mt-6 grid grid-cols-1 items-start gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
            {ftcTeams.map((team) => <TeamCard team={team} />)}
          </div>
        </div>
      </section>
    )
  }
</MarketingLayout>
