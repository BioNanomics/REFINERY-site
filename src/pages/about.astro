---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHeader from '../components/marketing/PageHeader.astro';
import SplitSection from '../components/marketing/SplitSection.astro';
import RuleList from '../components/marketing/RuleList.astro';
import CTAButton from '../components/marketing/CTAButton.astro';
import RandomTeamsTeaser from '../components/marketing/RandomTeamsTeaser.astro';
import ImpactStats from '../components/marketing/ImpactStats.astro';
import PeopleBios from '../components/marketing/PeopleBios.astro';
import ServiceAreaMap, { type ServiceAreaMarker } from '../components/marketing/ServiceAreaMap.astro';
import First from '../components/brand/First.astro';
import { firstPlain } from '../utils/first';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/base';
import { FACILITY_LOCATION, formatFacilityAddress } from '../utils/facility';
import { facility, person, personId } from '../utils/schema';
import { linkedinProfiles } from '../utils/people';
import { teamPath } from '../utils/teams';
import { serviceCounties } from '../data/service-area';

const allTeams = await getCollection('teams', ({ data }) => !data.draft);

// Static marker list for the service-area map: every team with a `location` set in its own
// frontmatter (src/content.config.ts), plus The REFINERY's own facility. A team without one
// (brand-new, before its coordinates are geocoded) just doesn't get a pin rather than failing
// the build.
const serviceAreaMarkers: ServiceAreaMarker[] = [
  ...allTeams.flatMap((team): ServiceAreaMarker[] => {
    if (!team.data.location) return [];
    return [
      {
        ...team.data.location,
        name: team.data.name,
        type: team.data.program,
        url: teamPath(team),
      },
    ];
  }),
  {
    ...FACILITY_LOCATION,
    name: 'The REFINERY',
    type: 'REFINERY',
    url: withBase('about/#facility'),
  },
];

// Derived from the structured address in src/utils/facility.ts, which the Organization and
// facility JSON-LD also read — so the visible address and the markup can't disagree.
const facilityAddress = formatFacilityAddress();
// t=h is hybrid — satellite imagery with road and place labels drawn over it, which is
// what Google's own "Satellite" toggle shows. Use t=k for bare imagery with no labels.
// z=18 frames the building; satellite at the default zoom is too far out to be useful.
const facilityMapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(facilityAddress)}&t=h&z=18&output=embed`;
// Ships as a plain Google Maps web URL so the link works with no JS and on desktop.
// A script at the foot of this page swaps it for a native handoff on mobile.
const facilityMapLinkUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(facilityAddress)}`;
const people = (await getCollection('people', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const partners = await getCollection('partners', ({ data }) => !data.draft);

// The facility Place plus one Person per bio on this page. Not merged into a @graph: BaseHead
// serializes whatever it's given, and each builder carries its own @context, so a plain array
// of independent nodes is both valid and the shape the rest of the site already emits.
//
// 768 matches the largest variant PeopleBios renders, so getImage reuses that build artifact
// instead of emitting another size just for the markup.
const personNodes = await Promise.all(
  people.map(async (profile) => {
    const { name, role, photo, bio } = profile.data;
    return person({
      id: personId(profile.id),
      name,
      jobTitle: role,
      description: bio ? firstPlain(bio) : undefined,
      image: photo
        ? new URL((await getImage({ src: photo, width: 768 })).src, Astro.site).href
        : undefined,
      sameAs: linkedinProfiles(profile).map(({ url }) => url),
    });
  }),
);

const aboutSchema = [
  facility({
    url: new URL(Astro.url.pathname, Astro.site).href,
    hasMap: facilityMapLinkUrl,
  }),
  ...personNodes,
];
---

<MarketingLayout
  title="Our Story, People & Facility"
  description="How The REFINERY started, the teams and partners we work with, the people behind it, and the Fort Wayne facility and shop that teams across the region share."
  jsonLd={aboutSchema}
>
  <PageHeader eyebrow="About" title="Who we are and how we work" />

  <SplitSection id="our-story" title="Our Story" rule={false}>
    <p data-reveal>
      Young robotics teams have long faced the same challenge: building
      a competitive program takes far more than a robot, and few schools or communities can build
      all of that infrastructure alone. The REFINERY grew out of a shared makerspace built to
      close that gap, and has since evolved from just a physical facility into a regional
      infrastructure organization supporting many teams across the region.
    </p>
  </SplitSection>

  <SplitSection id="mission-vision" title="Mission">
    <p data-reveal>
      The REFINERY exists so that no <First /> robotics team in Northeast Indiana has to build
      its infrastructure alone. We provide the funding, parts, tools, facilities, training, and
      community that let teams start, grow, and succeed.
    </p>
  </SplitSection>

  <SplitSection id="model" title="How the Model Works">
    <p
      class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-sm font-semibold text-brand sm:text-base"
      data-reveal
    >
      <span>Funding</span><span class="text-brand-accent">+</span>
      <span>Parts</span><span class="text-brand-accent">+</span>
      <span>Tools</span><span class="text-brand-accent">+</span>
      <span>Facilities</span><span class="text-brand-accent">+</span>
      <span>Training</span><span class="text-brand-accent">+</span>
      <span>Systems</span><span class="text-brand-accent">+</span>
      <span>Community</span><span class="text-brand-accent">=</span>
      <span class="text-brand-accent">Stronger, More Sustainable Teams</span>
    </p>
  </SplitSection>

  <SplitSection id="service-area" title="Where We Serve" wide>
    <p class="max-w-2xl" data-reveal>
      The REFINERY supports <First /> robotics teams across 12 counties in Northeast Indiana:
    </p>
    <RuleList columns={3} items={serviceCounties.map((county) => county.name)} />
    <div data-reveal>
      <ServiceAreaMap markers={serviceAreaMarkers} />
    </div>
    {/* Coverage details and every incorporated town, behind a native disclosure so the section stays short.
        Collapsed <details> content is still rendered, indexed page text — which is what
        lets a search for a small town ("robotics Ossian") find this page, and what makes
        these towns a published claim areaServed can repeat. Not hidden text: anyone can
        open it, and it answers a question visitors actually have. */}
    <details class="group border-y border-slate-300" data-reveal>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-4 font-heading text-2xl font-bold text-slate-900">
        Is my area/organization covered?
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-base group-open:rotate-180"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
      </summary>
      <div class="pb-5">
        {/* Coverage is defined by the county lines and the districts that cross them, not by
            this list — the towns are there so people can find themselves, and the copy says
            so, so an unlisted township or a district based next door doesn't read as excluded. */}
        <p class="text-base text-slate-600">
          We support schools and organizations anywhere within these 12 counties, whether or
          not your town appears below. That includes every school district that overlaps our
          county boundaries, even if the district is based in a neighboring county.
        </p>
        <p class="mt-3 text-base text-slate-600">Cities and towns in each county:</p>
        <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-3 text-base sm:grid-cols-2">
          {
            serviceCounties.map((county) => (
              <div>
                <dt class="font-medium text-slate-700">{county.name} County</dt>
                <dd class="text-slate-500">{county.towns.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </details>
    <p class="max-w-2xl" data-reveal>
      No team at your school or in your town yet? We help schools and community groups
      anywhere in these counties start one.{' '}
      <a href={withBase('get-involved/#start-or-host-a-team')} class="font-medium text-brand-accent underline hover:no-underline">
        Talk with us about starting a team
      </a>.
    </p>
  </SplitSection>

  <SplitSection id="teams" title="Meet the Teams" wide>
    <RandomTeamsTeaser teams={allTeams} />
    <div data-reveal>
      <CTAButton href={withBase('about/teams/')} variant="secondary">See All Teams</CTAButton>
    </div>
  </SplitSection>

  <SplitSection id="impact" title="Impact" wide>
    <ImpactStats />
  </SplitSection>

  <SplitSection id="people" title="People & Leadership" wide>
    <PeopleBios people={people} />
  </SplitSection>

  <SplitSection id="facility" title="Facility">
    <p data-reveal>
      The REFINERY doesn't keep regular hours, so every visit is by appointment, including
      visits from teams outside The REFINERY. Get in touch and we'll find a time.
    </p>
    <div data-reveal>
      <a
        href="mailto:info@refineryrobotics.org?subject=Visiting%20The%20REFINERY"
        data-contact-open="contact"
        class="inline-block font-mono text-sm font-semibold text-brand-accent hover:underline"
      >
        Request a visit &rarr;
      </a>
    </div>

    <h3 class="mt-4 font-heading text-2xl font-bold text-slate-900" data-reveal>In the shop</h3>
    <RuleList
      items={[
        'Full practice field',
        'CNC router',
        'Drill press',
        'Hydraulic press',
        'Shear, press brake, and slip roll combo',
        '14" vertical bandsaw',
      ]}
    />

    <h3 class="mt-4 font-heading text-2xl font-bold text-slate-900" data-reveal>Parking</h3>
    <p data-reveal>
      Parking is free on either side of Broadway, and there's a loading zone the size of two
      spaces directly outside our door. If you need somewhere else to put a trailer or a team's
      worth of cars, Electric Works publishes a{' '}
      <a
        href="https://fortwayneelectricworks.com/parking-map/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-accent underline hover:no-underline"
      >
        parking map
      </a>{' '}
      with more options.
    </p>

    <div class="card mt-2 overflow-hidden" data-reveal>
      <iframe
        src={facilityMapEmbedUrl}
        title="Map showing The REFINERY's location"
        class="h-[400px] w-full"
        style="border: 0"
        loading="lazy"
      />
    </div>
    <a
      href={facilityMapLinkUrl}
      data-map-link
      data-map-address={facilityAddress}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block font-mono text-sm font-semibold text-brand-accent hover:underline"
    >
      {facilityAddress}
    </a>
  </SplitSection>

  <SplitSection id="partners" title="Partners" wide>
      {/* A plain two-up grid, left-aligned in the content column. The row used to flip to one
          flex line from xl, which assumed the full 72rem container; in the narrower column beside
          a heading rail four logos of these widths would overflow, so it stays a grid. */}
      {
        partners.length > 0 ? (
          <div
            class="partner-row grid grid-cols-1 place-items-start gap-8 sm:grid-cols-2"
            data-reveal-group
          >
            {partners.map((partner) => {
              // A partner with no url gets a non-interactive wrapper, not a link to nowhere —
              // a real <a href="#"> was a focusable, "activatable" element that did nothing.
              const Tag = partner.data.url ? 'a' : 'div';
              return (
                <Tag
                  href={partner.data.url}
                  target={partner.data.url ? '_blank' : undefined}
                  data-no-external-arrow
                  rel={partner.data.url ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'transition duration-base ease-out-soft hover:-translate-y-0.5',
                  ]}
                  title={firstPlain(partner.data.name)}
                  data-reveal
                >
                  {/* logoHeight (content.config.ts) overrides the shared 102px height for a
                      logo — like Amp Lab's, which has almost no built-in padding — that would
                      otherwise read noticeably larger or smaller than the rest at that height. */}
                  <Image
                    src={partner.data.logo}
                    alt={firstPlain(partner.data.logoAlt ?? partner.data.name)}
                    class="w-auto max-w-[290px] object-contain"
                    style={`height: ${partner.data.logoHeight ?? 102}px`}
                  />
                </Tag>
              );
            })}
          </div>
        ) : (
          <p class="text-sm text-slate-500">Partner list coming soon.</p>
        )
      }
  </SplitSection>

  <SplitSection id="contact" title="Policies" loose>
    <p data-reveal>
      The REFINERY follows the{' '}
      <a
        href="https://www.firstinspires.org/programs/youth-protection-program"
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-accent underline hover:no-underline"
      >
        <First /> Youth Protection Policy
      </a>{' '}
      to keep every student, mentor, and volunteer safe.
    </p>
    <p data-reveal>
      Everyone using our facility follows The REFINERY's{' '}
      <a
        href="https://docs.google.com/document/d/1pEaRoxklMtsgSpg7-C6rHYIKlMl5dpkPGC4xDISE974/edit?tab=t.0#heading=h.ptazkv4428co"
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-accent underline hover:no-underline"
      >
        Space Use Rules
      </a>
      , covering safety, supervision, tool use, and facility conduct.
    </p>
  </SplitSection>
</MarketingLayout>

<script>
  // The facility address link ships as a Google Maps web URL, so it already works with
  // no JS and everywhere that isn't a phone. On mobile we rewrite it in place to hand
  // off to a native app instead:
  //
  //   Android — a geo: URI. This is the only form that honours whichever map app the
  //             user has actually set as their default; an https://maps.google.com link
  //             forces Google Maps regardless of that preference.
  //   iOS     — maps.apple.com, a universal link that opens the Maps app directly. iOS
  //             has no general "default map app" setting to respect (the EU-only
  //             navigation-default option aside), so Apple Maps is the right target.
  //
  // Anything else — desktop, or an unrecognised UA — keeps the Google Maps URL that was
  // already in the markup, which is the "no such thing" fallback.
  function initMapLink() {
    const link = document.querySelector<HTMLAnchorElement>('[data-map-link]');
    if (!link) return;

    const address = link.dataset.mapAddress;
    if (!address) return;
    const q = encodeURIComponent(address);

    const ua = navigator.userAgent;
    // iPadOS 13+ reports a Macintosh UA, so touch points are what separate it from a
    // desktop Mac — which should keep the web URL.
    const isIOS =
      /iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);

    if (/Android/.test(ua)) link.href = `geo:0,0?q=${q}`;
    else if (isIOS) link.href = `https://maps.apple.com/?q=${q}`;
    else return;

    // Handing off to an app replaces the page's context rather than opening a browser
    // tab, so target=_blank would strand an empty tab behind once the app launches.
    link.removeAttribute('target');
    link.removeAttribute('rel');
  }

  initMapLink();
  // Matches the reveal script's pattern in MarketingLayout — a no-op today, but correct
  // if view transitions are ever turned on.
  document.addEventListener('astro:page-load', initMapLink);
</script>
