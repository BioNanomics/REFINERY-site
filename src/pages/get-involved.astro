---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import CTAButton from '../components/marketing/CTAButton.astro';
import { withBase } from '../utils/base';

---

<MarketingLayout
  title="Get Involved"
  description="Start or host a team, volunteer, partner, give, or refer someone to The REFINERY."
>
  <section class="section-tight section text-center">
    <div class="section-inner section-inner-narrow">
      <SectionHeading eyebrow="Get Involved" title="Help build the infrastructure teams can't build alone" align="center" />
    </div>
  </section>

  <section id="start-or-host-a-team" class="section scroll-mt-6">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>01</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Start or Host a Team</h2>
      <p class="mt-3 text-sm text-slate-500" data-reveal>For schools, nonprofits, libraries, youth organizations, parents, and community groups.</p>
      <p class="mt-4 text-slate-600" data-reveal>
        We'll walk you through what starting a team requires, what your organization provides, and
        how The REFINERY supports the process from kickoff onward.
      </p>
      <div class="mt-6" data-reveal>
        <CTAButton href="mailto:refinery@bionanomics.com?subject=Starting%20a%20Team">
          Talk With Us About Starting a Team
        </CTAButton>
      </div>
    </div>
  </section>

  <section id="volunteer" class="band scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>02</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Volunteer</h2>
      <p class="mt-4 text-slate-600" data-reveal>Whether you have an hour or a season, there's a place for you — one-time and long-term involvement are both welcome.</p>
      <p class="mt-4 text-slate-600" data-reveal>
        Technical advising, workshop instruction, open-shop support, events, inventory and
        facility projects, software development, administrative support, transportation, student
        engagement, and ongoing team mentoring.
      </p>
      <div class="mt-6" data-reveal>
        <CTAButton href="mailto:refinery@bionanomics.com?subject=Volunteering%20with%20The%20REFINERY" variant="secondary">
          Volunteer With Us
        </CTAButton>
      </div>
    </div>
  </section>

  <section id="partner" class="section-rule scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>03</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Partner</h2>
      <p class="mt-4 text-slate-600" data-reveal>
        Organizations and businesses partner with us in a lot of different ways: co-delivering
        programs, providing technical expertise, supplying employee volunteers, donating
        equipment or materials, supporting event infrastructure, developing shared software or
        systems, hosting student career experiences, supporting team launches, and funding
        regional infrastructure.
      </p>
      <div class="mt-6" data-reveal>
        <CTAButton href="mailto:refinery@bionanomics.com?subject=Partnering%20with%20The%20REFINERY" variant="secondary">
          Talk With Us About Partnering
        </CTAButton>
      </div>
    </div>
  </section>

  <section id="donate-or-sponsor" class="band scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>04</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Donate or Sponsor</h2>
      <p class="mt-4 text-slate-600" data-reveal>
        Giving starts new teams, supports team funding, expands shared inventory, purchases
        tools and equipment, supports transportation, funds workshops, supports student
        experiences, sustains facility operations, and develops shared software infrastructure.
        Team-designated giving is available where appropriate.
      </p>
      <div class="mt-6" data-reveal>
        <CTAButton href={withBase('donate/')}>See Ways to Give</CTAButton>
      </div>
    </div>
  </section>

  <section id="refer" class="section-loose scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>05</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Refer a Team or Student</h2>
      <p class="mt-4 text-slate-600" data-reveal>
        Know a student who may benefit, a team that needs support, a potential mentor, or an
        organization interested in starting a team? Let us know and we'll follow up.
      </p>
      <div class="mt-6" data-reveal>
        <CTAButton href="mailto:refinery@bionanomics.com?subject=Referral" variant="secondary">
          Send a Referral
        </CTAButton>
      </div>
    </div>
  </section>
</MarketingLayout>
