---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import SummaryCard from '../components/marketing/SummaryCard.astro';
import Carousel from '../components/marketing/Carousel.astro';
import ImpactStats from '../components/marketing/ImpactStats.astro';
import CTAButton from '../components/marketing/CTAButton.astro';
import First from '../components/brand/First.astro';
import { withBase } from '../utils/base';
import heroImage from '../assets/refinery-shop-1.jpeg';

const whatWeProvide = [
  {
    title: 'Team Launch & Organizational Support',
    description: 'Helping new and developing teams build the organizational foundation they need to last.',
    href: withBase('what-we-do/#team-launch'),
    icon: 'launch',
  },
  {
    title: 'Funding & Financial Infrastructure',
    description: 'Helping teams raise, receive, manage, and spend funds through The REFINERY.',
    href: withBase('what-we-do/#funding'),
    icon: 'funding',
  },
  {
    title: 'Parts & Inventory',
    description: 'Providing access to shared robot components, materials, hardware, and build-season essentials.',
    href: withBase('what-we-do/#parts-inventory'),
    icon: 'parts',
  },
  {
    title: 'Tools & Fabrication',
    description: 'Giving teams access to specialized tools and production capabilities to turn designs into finished parts.',
    href: withBase('what-we-do/#tools-fabrication'),
    icon: 'tools',
  },
  {
    title: 'Facilities & Field Access',
    description: 'Providing space to build, meet, collaborate, practice, and participate in robotics activities.',
    href: withBase('what-we-do/#facilities'),
    icon: 'facilities',
  },
  {
    title: 'Training & Technical Support',
    description: 'Providing students and mentors with practical instruction, resources, and troubleshooting assistance.',
    href: withBase('what-we-do/#training'),
    icon: 'training',
  },
  {
    title: 'Community & Student Experience',
    description: 'Creating opportunities for students and mentors to build relationships and community beyond their individual teams.',
    href: withBase('what-we-do/#community'),
    icon: 'community',
  },
] as const;

// Deliberately link-less: every one of these would point at the same What We Do
// section as the "See Our Contributions" button below them, so the button is the
// section's single path and these stay plain descriptive cards.
const beyondNortheastIndiana = [
  {
    title: 'Robot in 3 Days',
    description: "A documented rapid-build immediately following each year's FIRST Robotics Competition game reveal.",
    icon: 'robot',
  },
  {
    title: 'KitBot in 3 Days',
    description: 'A rapid, documented KitBot build to help developing teams assemble, program, and iterate.',
    icon: 'kit',
  },
  {
    title: 'TIMS',
    description: 'Inventory and tool-management software built for The REFINERY, and built to be open to any FIRST team.',
    status: 'Currently beta testing',
    icon: 'clipboard',
  },
  {
    title: 'Event Parts Support',
    description: 'Live parts inventory at events, helping teams get back on the field when issues come up.',
    icon: 'map-pin',
  },
  {
    title: 'Shop & Practice Field Access',
    description:
      'Teams outside The REFINERY can utilize our CNC router, fabrication equipment, and full-size practice field by appointment.',
    icon: 'facilities',
  },
] as const;
---

<MarketingLayout
  title="Home"
  description="The REFINERY helps Northeast Indiana's FIRST robotics teams start, grow, and succeed with funding, parts, tools, facilities, training, and community."
>
  <Hero
    eyebrow="The REFINERY"
    title="Shared infrastructure for stronger robotics teams"
    description="The REFINERY helps Northeast Indiana's FIRST robotics teams start, grow, and succeed by providing funding, parts, tools, facilities, training, and a regional community."
    ctaLabel="Explore What We Do"
    ctaHref={withBase('what-we-do/')}
    image={heroImage}
    imageAlt="A competition robot and shop equipment inside The REFINERY's makerspace"
  >
    <Fragment slot="actions">
      <CTAButton href={withBase('get-involved/')} variant="secondary">Get Involved</CTAButton>
      <CTAButton href={withBase('donate/')} variant="secondary">Donate</CTAButton>
    </Fragment>
  </Hero>

  <!-- The Problem -->
  <section class="section-loose section">
    <div class="section-inner">
      <SectionHeading
        eyebrow="The Problem"
        title="A team is more than just a robot"
        align="left"
      />
      <p class="mt-4 max-w-3xl text-slate-600" data-reveal>
        Sustainable robotics teams need far more than a kit of parts. They need funding, tools,
        workspace, technical knowledge, mentors, operational systems, and institutional continuity,
        and many schools and communities can't independently build all of that infrastructure on
        their own.
      </p>
    </div>
  </section>

  <!-- What The REFINERY Provides -->
  <section class="section-rule section">
    <div class="section-inner">
      <SectionHeading eyebrow="What We Provide" title="How The REFINERY helps teams" align="left" />
      <div class="mt-8" data-reveal-group>
        <Carousel ariaLabel="How The REFINERY helps teams">
          {whatWeProvide.map((item) => <SummaryCard {...item} class="w-[85%] flex-none sm:w-72 lg:w-80" />)}
        </Carousel>
      </div>
    </div>
  </section>

  <!-- Beyond Northeast Indiana -->
  <section class="section-rule section">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Beyond Northeast Indiana"
        title="Built here. Shared with FIRST."
        description="While rooted in Northeast Indiana, many of the systems and projects we develop are intended to support the broader FIRST community. We share what we build, document what we learn, and partner to solve challenges teams face everywhere."
        align="left"
      />
      {/* Two 3/2 rows at lg on a 5-col track, with the wide card swapping sides
          between them so the pair reads as a zigzag rather than one column of wide
          cards beside a column of narrow ones. The odd fifth card then spans the full
          track instead of sitting alone in a 2-col stub — same reason it spans both
          columns at sm, and the same treatment it gets on What We Do. */}
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-5" data-reveal-group>
        {
          beyondNortheastIndiana.map((item, i) => {
            const isLastOdd = i === beyondNortheastIndiana.length - 1 && i % 2 === 0;
            return (
              <SummaryCard
                {...item}
                class={
                  isLastOdd
                    ? 'sm:col-span-2 lg:col-span-5'
                    : i === 0 || i === 3
                      ? 'lg:col-span-3'
                      : 'lg:col-span-2'
                }
              />
            );
          })
        }
      </div>
      <div class="mt-8" data-reveal>
        <CTAButton href={withBase('what-we-do/#beyond-northeast-indiana')} variant="secondary">
          See Our Contributions to the <First /> Community
        </CTAButton>
      </div>
    </div>
  </section>

  <!-- Impact Snapshot -->
  <section class="section-rule section-tight section">
    <div class="section-inner">
      <SectionHeading eyebrow="Impact" title="Impact snapshot" align="left" />
      <div class="mt-8">
        <ImpactStats />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-rule section-loose section text-center">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Join Us"
        title="Help build the infrastructure robotics teams can't build alone"
        align="center"
      />
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3" data-reveal>
        <CTAButton href={withBase('get-involved/#volunteer')}>Volunteer</CTAButton>
        <CTAButton href={withBase('get-involved/#partner')} variant="secondary">Partner</CTAButton>
        <CTAButton href={withBase('donate/')} variant="secondary">Donate</CTAButton>
      </div>
    </div>
  </section>
</MarketingLayout>
