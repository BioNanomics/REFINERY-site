---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHeader from '../components/marketing/PageHeader.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import Icon from '../components/marketing/Icon.astro';
import FirstText from '../components/brand/FirstText.astro';
import ImpactStats from '../components/marketing/ImpactStats.astro';
import CTAButton from '../components/marketing/CTAButton.astro';
import EventBanner from '../components/marketing/EventBanner.astro';
import First from '../components/brand/First.astro';
import { withBase } from '../utils/base';
import { firstPlain } from '../utils/first';
import { organization, website, personId } from '../utils/schema';
import { isPastEvent } from '../utils/events';
import { getCollection } from 'astro:content';
import logoFullColor from '../assets/logo-full-color.svg';
import heroImage from '../assets/refinery-shop-1.jpeg';

const metaDescription =
  'The REFINERY supports youth robotics in Fort Wayne and Northeast Indiana, helping FIRST teams start, grow, and succeed with funding, tools, space, and training.';

// Read from the collection rather than written out here, so the founder's name lives in exactly
// one place and this node shares an @id with the Person node /about/ builds from the same entry.
// No entry flagged means no founder property, rather than a guess.
const founderEntry = (await getCollection('people', ({ data }) => data.founder && !data.draft))[0];

// The homepage carries the site's Organization node. Every value traces to something already
// published — see the sourcing notes in src/utils/schema.ts.
const orgSchema = organization({
  logo: new URL(logoFullColor.src, Astro.site).href,
  image: new URL(withBase('images/og-default.jpeg'), Astro.site).href,
  description: firstPlain(metaDescription),
  founder: founderEntry
    ? { name: founderEntry.data.name, id: personId(founderEntry.id) }
    : undefined,
});

// The soonest upcoming featured event, if any. Featured is the flag that gives an event a
// detail page, so it's also what earns a homepage banner. Past events drop off at the next
// build — see src/utils/events.ts — so the banner retires itself without a code change.
const nextFeaturedEvent = (
  await getCollection('events', ({ data }) => data.featured && !data.draft && !isPastEvent(data))
).sort((a, b) => a.data.dateStart.valueOf() - b.data.dateStart.valueOf())[0];

const whatWeProvide = [
  {
    title: 'Team Launch & Organizational Support',
    description: 'Helping new and developing teams build the organizational foundation they need to last.',
    href: withBase('what-we-do/#team-launch'),
    icon: 'launch',
  },
  {
    title: 'Funding & Financial Infrastructure',
    description: 'Helping teams raise, receive, manage, and spend funds through The REFINERY.',
    href: withBase('what-we-do/#funding'),
    icon: 'funding',
  },
  {
    title: 'Parts & Inventory',
    description: 'Providing access to shared robot components, materials, hardware, and build-season essentials.',
    href: withBase('what-we-do/#parts-inventory'),
    icon: 'parts',
  },
  {
    title: 'Tools & Fabrication',
    description: 'Giving teams access to specialized tools and production capabilities to turn designs into finished parts.',
    href: withBase('what-we-do/#tools-fabrication'),
    icon: 'tools',
  },
  {
    title: 'Facilities & Field Access',
    description: 'Providing space to build, meet, collaborate, practice, and participate in robotics activities.',
    href: withBase('what-we-do/#facilities'),
    icon: 'facilities',
  },
  {
    title: 'Training & Technical Support',
    description: 'Providing students and mentors with practical instruction, resources, and troubleshooting assistance.',
    href: withBase('what-we-do/#training'),
    icon: 'training',
  },
  {
    title: 'Community & Student Experience',
    description: 'Creating opportunities for students and mentors to build relationships and community beyond their individual teams.',
    href: withBase('what-we-do/#community'),
    icon: 'community',
  },
] as const;

// Deliberately link-less: every one of these would point at the same What We Do
// section as the "See Our Contributions" button below them, so the button is the
// section's single path and these stay plain descriptive cards.
const beyondNortheastIndiana = [
  {
    title: 'Robot in 3 Days',
    description: "A documented rapid-build immediately following each year's FIRST Robotics Competition game reveal.",
    icon: 'robot',
  },
  {
    title: 'KitBot in 3 Days',
    description: 'A rapid, documented KitBot build to help developing teams assemble, program, and iterate.',
    icon: 'kit',
  },
  {
    title: 'TIMS',
    description: 'Inventory and tool-management software built for The REFINERY, and built to be open to any FIRST team.',
    status: 'Currently beta testing',
    icon: 'clipboard',
  },
  {
    title: 'Event Parts Support',
    description: 'Live parts inventory at events, helping teams get back on the field when issues come up.',
    icon: 'map-pin',
  },
  {
    title: 'Shop & Practice Field Access',
    description:
      'Teams outside The REFINERY can utilize our CNC router, fabrication equipment, and full-size practice field by appointment.',
    icon: 'facilities',
  },
] as const;
---

{/* Not "Home": the title is the single most valuable slot on the site, and this is the page
    most likely to rank for the service plus the region. Worded in the searcher's terms
    ("youth robotics", "Fort Wayne") rather than the community's ("FIRST teams"), which the
    description and body still carry — see keyword-research.md. At 48 characters the brand
    suffix would overflow the ~60 budget, so BaseHead drops it; the WebSite node's name still
    gives search results the brand as the site name. */}
<MarketingLayout
  title="Youth Robotics in Fort Wayne & Northeast Indiana"
  description={metaDescription}
  jsonLd={[orgSchema, website()]}
>
  {nextFeaturedEvent && <EventBanner event={nextFeaturedEvent} />}

  <PageHeader
    eyebrow="The REFINERY"
    title="Shared infrastructure for stronger robotics teams"
    description="The REFINERY helps youth FIRST robotics teams in Fort Wayne and across Northeast Indiana start, grow, and succeed by providing funding, parts, tools, facilities, training, and a regional community."
    image={heroImage}
    imageAlt="Three FIRST Robotics Competition robots sitting outside the edge of The REFINERY's practice field, with the field in the background and yellow fuel balls scattered across it"
  >
    <Fragment slot="actions">
      <CTAButton href={withBase('what-we-do/')}>Explore What We Do</CTAButton>
      <CTAButton href={withBase('get-involved/')} variant="secondary">Get Involved</CTAButton>
      <CTAButton href={withBase('donate/')} variant="secondary">Donate</CTAButton>
    </Fragment>
  </PageHeader>

  <!-- Video -->
  <section class="section-tight section pt-0">
    <div class="section-inner">
      <div class="corner-brackets overflow-hidden rounded-card" data-reveal style="--bracket-inset: -10px">
        <iframe
          src="https://www.youtube-nocookie.com/embed/HkI-0t82Ryc?si=jgUL6tOxqtDZRPP0&controls=0"
          title="FIRST - Not a Robot (YouTube video)"
          class="block aspect-video w-full"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- The Problem -->
  <section class="section-loose section">
    <div class="section-inner">
      <SectionHeading
        eyebrow="The Problem"
        title="A team is more than just a robot"
        align="left"
      />
      <p class="mt-4 max-w-3xl text-slate-600" data-reveal>
        Sustainable robotics teams need far more than a kit of parts. They need funding, tools,
        workspace, technical knowledge, mentors, operational systems, and institutional continuity,
        and many schools and communities can't independently build all of that infrastructure on
        their own.
      </p>
    </div>
  </section>

  <!-- What The REFINERY Provides -->
  <section class="section-rule section">
    <div class="section-inner">
      <SectionHeading eyebrow="What We Provide" title="How The REFINERY helps teams" align="left" />
      {/* An open ruled list, not a carousel or a card grid: all seven are visible at once on
          every screen, and the hairlines do the separating that card borders used to. The odd
          seventh row spans both columns instead of leaving a hole beside it. */}
      <ul class="mt-10 grid grid-cols-1 gap-x-12 md:grid-cols-2" data-reveal-group>
        {
          whatWeProvide.map((item, i) => (
            <li
              class:list={['border-t border-slate-300', i === whatWeProvide.length - 1 && i % 2 === 0 && 'md:col-span-2']}
              data-reveal
            >
              <a href={item.href} class="group flex gap-4 py-6">
                <span class="mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-control bg-brand-accent-fill/10 text-brand-accent">
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <span class="flex flex-col">
                  <span class="font-heading text-2xl font-bold leading-tight text-slate-900 group-hover:text-brand-accent">
                    <FirstText text={item.title} context="heading" />
                  </span>
                  <span class="mt-1 max-w-md text-base text-slate-600"><FirstText text={item.description} /></span>
                  <span class="mt-3 font-mono text-sm font-semibold text-brand-accent group-hover:underline">Explore &rarr;</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Beyond Northeast Indiana -->
  <section class="section-rule section">
    <div class="section-inner grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div class="flex flex-col items-start gap-8">
        <SectionHeading
          eyebrow="Beyond Northeast Indiana"
          title="Built here. Shared with FIRST."
          description="While rooted in Northeast Indiana, many of the systems and projects we develop are intended to support the broader FIRST community. We share what we build, document what we learn, and partner to solve challenges teams face everywhere."
          align="left"
        />
        <div data-reveal>
          <CTAButton href={withBase('what-we-do/#beyond-northeast-indiana')} variant="secondary">
            See Our Contributions to the <First /> Community
          </CTAButton>
        </div>
      </div>
      <ul data-reveal-group class="self-start">
        {
          beyondNortheastIndiana.map((item) => (
            <li class="border-t border-slate-300 py-5 last:border-b" data-reveal>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <h3 class="font-heading text-2xl font-bold leading-tight text-slate-900">{item.title}</h3>
                {'status' in item && <span class="status-tag">{item.status}</span>}
              </div>
              <p class="mt-1 max-w-lg text-base text-slate-600"><FirstText text={item.description} /></p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Impact Snapshot -->
  <section class="section-rule section-tight section">
    <div class="section-inner">
      <SectionHeading eyebrow="Impact" title="Impact snapshot" align="left" />
      <div class="mt-8">
        <ImpactStats />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-rule section-loose section text-center">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Join Us"
        title="Help build the infrastructure robotics teams can't build alone"
        align="center"
      />
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3" data-reveal>
        <CTAButton href={withBase('get-involved/#volunteer')}>Volunteer</CTAButton>
        <CTAButton href={withBase('get-involved/#partner')} variant="secondary">Partner</CTAButton>
        <CTAButton href={withBase('donate/')} variant="secondary">Donate</CTAButton>
      </div>
    </div>
  </section>
</MarketingLayout>
