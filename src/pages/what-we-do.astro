---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHeader from '../components/marketing/PageHeader.astro';
import SplitSection from '../components/marketing/SplitSection.astro';
import RuleList from '../components/marketing/RuleList.astro';
import CTAButton from '../components/marketing/CTAButton.astro';
import First from '../components/brand/First.astro';
import { withBase } from '../utils/base';
---

<MarketingLayout
  title="Funding, Parts, Tools & Training for Teams"
  description="How The REFINERY supports robotics teams: team launch, funding, parts, tools, facilities, training, community, and what we give back to FIRST."
>
  <PageHeader eyebrow="What We Do" title="The full picture of how we support teams" />

  <SplitSection id="team-launch" title="Team Launch & Organizational Support" rule={false}>
    <p data-reveal>The REFINERY helps organizations:</p>
    <RuleList
      items={[
        'Launch new teams',
        'Select appropriate FIRST programs',
        'Establish leadership and mentor structures',
        'Develop team procedures',
        'Plan budgets and purchasing',
        'Onboard students and mentors',
        'Prepare for competition seasons',
        'Build institutional continuity',
      ]}
    />
    <p data-reveal>
      Teams that started this way are now competing across the region. See{' '}
      <a href={withBase('about/teams/')} class="text-brand-accent underline hover:no-underline">the teams we support</a>.
    </p>
    <div data-reveal>
      <CTAButton href="mailto:info@refineryrobotics.org?subject=Starting%20a%20Team" variant="secondary" dialog="contact" topic="Starting a team">
        Talk With Us About Starting a Team
      </CTAButton>
    </div>
  </SplitSection>

  <SplitSection id="funding" title="Funding & Financial Infrastructure">
    <p data-reveal>The REFINERY provides funding directly to teams, gives teams a platform to raise funds, maintains optional team subaccounts, allows teams to pursue external grants through The REFINERY, administers designated and restricted funds, and supports team purchasing.</p>
    <h3 class="mt-4 font-heading text-2xl font-bold text-slate-900" data-reveal>Three spending pathways</h3>
    <RuleList
      columns={1}
      items={[
        "Transfer funds to the team's school or primary financial organization.",
        "Purchase items from The REFINERY's inventory.",
        'Have The REFINERY purchase outside products selected by the team.',
      ]}
    />
  </SplitSection>

  <SplitSection id="parts-inventory" title="Parts & Inventory">
    <RuleList
      items={[
        'Shared robot-parts inventory',
        'Electrical components',
        'Hardware and fasteners',
        'Materials and consumables',
        'Build-season emergency availability',
        'Centralized purchasing efficiencies',
      ]}
    />
  </SplitSection>

  <SplitSection id="tools-fabrication" title="Tools & Fabrication">
    <RuleList
      items={[
        'CNC routing',
        '3D printing',
        'Mechanical fabrication',
        'Electrical work',
        'Printing and apparel production',
        'Specialized tool access',
        'Custom robot-part production',
      ]}
    />
  </SplitSection>

  <SplitSection id="facilities" title="Facilities & Field Access">
    <p data-reveal>Our physical space supports:</p>
    <RuleList
      items={[
        'Robot construction',
        'Team meetings',
        'Collaboration',
        'Technical training',
        'Practice',
        'Field access',
        'Scrimmages',
        'Parts distribution',
        'Community events',
      ]}
    />
  </SplitSection>

  <SplitSection id="training" title="Training & Technical Support">
    <RuleList
      columns={1}
      items={[
        'Programming, CAD, mechanical, and electrical systems',
        'CNC design and 3D printing',
        'Robot tuning and competition preparation',
        'Mentor development and technical troubleshooting',
      ]}
    />
  </SplitSection>

  <SplitSection id="community" title="Community & Student Experience">
    <RuleList
      items={[
        'Mentor Meetups',
        'Cross-team collaboration',
        'From Pits to Prom',
        'Student social activities',
        'Team culture and engagement efforts',
        'Shared build projects',
        'Outreach and demonstrations',
      ]}
    />
  </SplitSection>

  <SplitSection id="beyond-northeast-indiana" loose>
    <Fragment slot="title">Beyond Northeast Indiana: Contributions to the <First context="heading" /> Community</Fragment>
    <p data-reveal>
      While The REFINERY is rooted in Northeast Indiana, many of the systems, projects, and
      resources we develop are intended to support the broader <First /> community. We share what
      we build, document what we learn, and partner with other organizations to solve
      challenges teams face everywhere.
    </p>

    {/* Projects as a ledger rather than five boxes: each is a name, a status when it has one, and
        a short account, and the hairlines separate them. */}
    <ul class="mt-2" data-reveal-group>
      <li class="border-t border-slate-300 py-5" data-reveal>
        <h3 class="font-heading text-2xl font-bold text-slate-900">Robot in 3 Days</h3>
        <p class="mt-1 text-base text-slate-600">
          The REFINERY designs and builds a robot immediately following the annual{' '}
          <First /> Robotics Competition game reveal, documenting the design process,
          prototypes, decisions, failures, and final robot for teams to learn from.
        </p>
      </li>
      <li class="border-t border-slate-300 py-5" data-reveal>
        <h3 class="font-heading text-2xl font-bold text-slate-900">KitBot in 3 Days</h3>
        <p class="mt-1 text-base text-slate-600">
          A rapid, documented KitBot build focused on helping developing teams understand how
          to assemble, program, troubleshoot, and begin iterating on the official <First /> Robotics Competition KitBot.
        </p>
      </li>
      <li class="border-t border-slate-300 py-5" data-reveal>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h3 class="font-heading text-2xl font-bold text-slate-900">TIMS</h3>
          <span class="status-tag">Currently beta testing</span>
        </div>
        <p class="mt-1 text-base text-slate-600">
          Inventory and tool-management software developed for The REFINERY, and built to be
          available to any <First /> team that wants to use it.
        </p>
      </li>
      <li class="border-t border-slate-300 py-5" data-reveal>
        <h3 class="font-heading text-2xl font-bold text-slate-900">Event Parts Support</h3>
        <p class="mt-1 text-base text-slate-600">
          Partnerships with <First /> Indiana Robotics and MentorBridge to provide live parts
          inventory at events, helping teams identify and access components when technical
          issues occur.
        </p>
      </li>
      <li class="border-y border-slate-300 py-5" data-reveal>
        <h3 class="font-heading text-2xl font-bold text-slate-900">Shop & Practice Field Access</h3>
        <p class="mt-1 text-base text-slate-600">
          Our shop and full-size practice field are open to teams outside The REFINERY by
          appointment. Visiting teams can utilize our CNC router and other fabrication
          equipment and drive, tune, and practice on our field before competition.
        </p>
        <a
          href="mailto:info@refineryrobotics.org?subject=Visiting%20The%20REFINERY"
          data-contact-open="contact"
          class="mt-3 inline-block font-mono text-sm font-semibold text-brand-accent hover:underline"
        >
          Ask about visiting &rarr;
        </a>
      </li>
    </ul>

    <h3 class="mt-6 font-heading text-2xl font-bold text-slate-900" data-reveal>Sharing what we learn</h3>
    <RuleList
      items={[
        'Open Alliance participation',
        'Public documentation',
        'Templates and team-development systems',
        'Software and digital tools',
        'Workshop materials',
        'Other open or reusable projects',
      ]}
    />
  </SplitSection>
</MarketingLayout>
