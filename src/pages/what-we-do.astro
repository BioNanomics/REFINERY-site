---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import CTAButton from '../components/marketing/CTAButton.astro';
import First from '../components/brand/First.astro';
import FirstText from '../components/brand/FirstText.astro';
import { withBase } from '../utils/base';
---

<MarketingLayout
  title="What We Do"
  description="How The REFINERY supports robotics teams — team launch, funding, parts, tools, facilities, training, community, and our contributions to the wider FIRST community."
>
  <section class="section-tight section">
    <div class="section-inner">
      <SectionHeading eyebrow="What We Do" title="The full picture of how we support teams" align="left" />
    </div>
  </section>

  <section id="team-launch" class="section scroll-mt-6">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>01</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Team Launch & Organizational Support</h2>
      <p class="mt-4 text-slate-600" data-reveal>The REFINERY helps organizations:</p>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2" data-reveal>
        {
          [
            'Launch new teams',
            'Select appropriate FIRST programs',
            'Establish leadership and mentor structures',
            'Develop team procedures',
            'Plan budgets and purchasing',
            'Onboard students and mentors',
            'Prepare for competition seasons',
            'Build institutional continuity',
          ].map((item) => (
            <li class="rounded-r-control border-l-2 border-brand-accent py-1 pl-4 text-sm text-slate-600"><FirstText text={item} /></li>
          ))
        }
      </ul>
      <div class="mt-6" data-reveal>
        <CTAButton href={withBase('get-involved/#start-or-host-a-team')} variant="secondary">
          Talk With Us About Starting a Team
        </CTAButton>
      </div>
    </div>
  </section>

  <section id="funding" class="section-rule scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>02</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Funding & Financial Infrastructure</h2>
      <p class="mt-4 text-slate-600" data-reveal>The REFINERY provides funding directly to teams, gives teams a platform to raise funds, maintains optional team subaccounts, allows teams to pursue external grants through The REFINERY, administers designated and restricted funds, and supports team purchasing.</p>
      <h3 class="mt-6 font-heading text-lg font-bold text-slate-900" data-reveal>Three spending pathways</h3>
      <ol class="mt-3 flex flex-col gap-2" data-reveal>
        {
          [
            "Transfer funds to the team's school or primary financial organization.",
            "Purchase items from The REFINERY's inventory.",
            'Have The REFINERY purchase outside products selected by the team.',
          ].map((item, i) => (
            <li class="flex gap-3 text-sm text-slate-600">
              <span class="font-mono font-bold text-brand-accent">{i + 1}.</span>
              {item}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="parts-inventory" class="section-rule scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>03</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Parts & Inventory</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2" data-reveal>
        {
          [
            'Shared robot-parts inventory',
            'Electrical components',
            'Hardware and fasteners',
            'Materials and consumables',
            'Build-season emergency availability',
            'Centralized purchasing efficiencies',
          ].map((item) => (
            <li class="rounded-r-control border-l-2 border-brand-accent py-1 pl-4 text-sm text-slate-600"><FirstText text={item} /></li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-slate-500" data-reveal>Live inventory is managed through <a href="https://tims.bionanomics.com" target="_blank" rel="noopener noreferrer" class="text-brand-accent hover:underline">TIMS</a>.</p>
    </div>
  </section>

  <section id="tools-fabrication" class="section-rule scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>04</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Tools & Fabrication</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2" data-reveal>
        {
          [
            'CNC routing',
            '3D printing',
            'Mechanical fabrication',
            'Electrical work',
            'Printing and apparel production',
            'Specialized tool access',
            'Custom robot-part production',
          ].map((item) => (
            <li class="rounded-r-control border-l-2 border-brand-accent py-1 pl-4 text-sm text-slate-600"><FirstText text={item} /></li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="facilities" class="band scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>05</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Facilities & Field Access</h2>
      <p class="mt-4 text-slate-600" data-reveal>Our physical space supports:</p>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2" data-reveal>
        {
          [
            'Robot construction',
            'Team meetings',
            'Collaboration',
            'Technical training',
            'Practice',
            'Field access',
            'Scrimmages',
            'Parts distribution',
            'Community events',
          ].map((item) => (
            <li class="rounded-r-control border-l-2 border-brand-accent py-1 pl-4 text-sm text-slate-600"><FirstText text={item} /></li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="training" class="section-rule scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>06</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Training & Technical Support</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2" data-reveal>
        {
          [
            'Programming, CAD, mechanical, and electrical systems',
            'CNC design and 3D printing',
            'Robot tuning and competition preparation',
            'Mentor development and technical troubleshooting',
          ].map((item) => (
            <li class="rounded-r-control border-l-2 border-brand-accent py-1 pl-4 text-sm text-slate-600"><FirstText text={item} /></li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="community" class="section-rule scroll-mt-6 section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>07</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Community & Student Experience</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2" data-reveal>
        {
          [
            'Mentor Meetups',
            'Cross-team collaboration',
            'From Pits to Prom',
            'Student social activities',
            'Team culture and engagement efforts',
            'Shared build projects',
            'Outreach and demonstrations',
          ].map((item) => (
            <li class="rounded-r-control border-l-2 border-brand-accent py-1 pl-4 text-sm text-slate-600"><FirstText text={item} /></li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="beyond-northeast-indiana" class="band scroll-mt-6 section-loose section">
    <div class="section-inner section-inner-narrow">
      <p class="eyebrow-tag text-brand-accent" data-reveal>08</p>
      <h2 class="mt-2 font-heading text-2xl font-bold text-slate-900 sm:text-3xl" data-reveal>Beyond Northeast Indiana: Contributions to the <First context="heading" /> Community</h2>
      <p class="mt-4 text-slate-600" data-reveal>
        While The REFINERY is rooted in Northeast Indiana, many of the systems, projects, and
        resources we develop are intended to support the broader <First /> community. We share what
        we build, document what we learn, and partner with other organizations to solve
        challenges teams face everywhere.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2" data-reveal-group>
        <div class="card card-pad">
          <h3 class="font-heading text-base font-bold text-slate-900">Robot in 3 Days</h3>
          <p class="mt-2 text-sm text-slate-600">
            The REFINERY designs and builds a robot immediately following the annual{' '}
            <First /> Robotics Competition game reveal, documenting the design process,
            prototypes, decisions, failures, and final robot for teams to learn from.
          </p>
        </div>
        <div class="card card-pad">
          <h3 class="font-heading text-base font-bold text-slate-900">KitBot in 3 Days</h3>
          <p class="mt-2 text-sm text-slate-600">
            A rapid, documented KitBot build focused on helping developing teams understand how
            to assemble, program, troubleshoot, and begin iterating on the official FRC KitBot.
          </p>
        </div>
        <div class="card card-pad">
          <h3 class="font-heading text-base font-bold text-slate-900">TIMS</h3>
          <p class="mt-2 text-sm text-slate-600">
            Inventory and tool-management software developed for The REFINERY and made available
            to any <First /> team that wants to use it.
          </p>
          <a href="https://tims.bionanomics.com" target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-mono text-sm font-semibold text-brand-accent hover:underline">
            Open TIMS &rarr;
          </a>
        </div>
        <div class="card card-pad">
          <h3 class="font-heading text-base font-bold text-slate-900">Event Parts Support</h3>
          <p class="mt-2 text-sm text-slate-600">
            Partnerships with <First /> Indiana Robotics and MentorBridge to provide live parts
            inventory at events, helping teams identify and access components when technical
            issues occur.
          </p>
        </div>
      </div>

      <h3 class="mt-10 font-heading text-lg font-bold text-slate-900" data-reveal>Sharing what we learn</h3>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2" data-reveal>
        {
          [
            'Open Alliance participation',
            'Public documentation',
            'Templates and team-development systems',
            'Software and digital tools',
            'Workshop materials',
            'Other open or reusable projects',
          ].map((item) => (
            <li class="rounded-r-control border-l-2 border-brand-accent py-1 pl-4 text-sm text-slate-600"><FirstText text={item} /></li>
          ))
        }
      </ul>
    </div>
  </section>
</MarketingLayout>
