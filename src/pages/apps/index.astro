---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import SectionHeading from '../../components/marketing/SectionHeading.astro';
import AppCard from '../../components/cards/AppCard.astro';
import { getCollection } from 'astro:content';

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---

<MarketingLayout
  title="Apps"
  description="Software applications and tools built by or associated with The REFINERY makerspace."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <SectionHeading eyebrow="Apps" title="Tools we build and use" align="left" />
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((app) => <AppCard app={app} />)}
      <div class="flex flex-col items-start justify-center rounded-sm border border-dashed border-slate-300 p-6 text-sm text-slate-500">
        More apps coming soon.
      </div>
    </div>
  </section>
</MarketingLayout>
