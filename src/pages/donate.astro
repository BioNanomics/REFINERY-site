---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';

const outcomes = [
  'Start new teams',
  'Support team funding',
  'Expand shared inventory',
  'Purchase tools and equipment',
  'Fund workshops',
  'Support student experiences',
  'Sustain facility operations',
  'Develop shared software infrastructure',
  'Feed our community with snacks and coffee',
];
---

<MarketingLayout
  title="Donate"
  description="Give to The REFINERY and help fund the infrastructure robotics teams across Northeast Indiana can't build alone."
>
  <section class="section-tight section text-center">
    <div class="section-inner section-inner-narrow">
      <SectionHeading eyebrow="Donate" title="Your gift builds infrastructure teams share" align="center" />
      <p class="mx-auto mt-4 max-w-2xl text-slate-600" data-reveal>
        Every gift to The REFINERY goes toward the funding, parts, tools, facilities, and training
        that keep robotics teams across Northeast Indiana running, and helps us launch new teams
        that couldn't otherwise get started.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner section-inner-narrow">
      <SectionHeading eyebrow="Where it goes" title="What your gift can support" align="left" />
      <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3" data-reveal-group>
        {
          outcomes.map((outcome) => (
            <li class="card rounded-r-control border-l-2 border-l-brand-accent py-2 pl-4 text-sm text-slate-700" data-reveal>{outcome}</li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-slate-500" data-reveal>
        Want your gift directed to a specific team? Let us know when you give and we'll make
        sure it gets there.
      </p>
    </div>
  </section>

  <section class="section-rule section-loose section flex flex-col items-center text-center">
    <div class="section-inner section-inner-narrow flex flex-col items-center">
      <SectionHeading eyebrow="Give Today" title="Ready to give?" align="center" />
      <div class="mt-6 w-full" data-reveal>
        <div data-zeffy-embed data-form-url="/embed/donation-form/donate-to-support-our-future-engineers-and-entrepreneurs"></div>
        <div data-zeffy-embed-fallback style="display:none;">
          <div style="position:relative;overflow:hidden;height:450px;width:100%;">
            <iframe
              title="Donation form powered by Zeffy"
              style="position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:100%"
              data-zeffy-embed-src="https://www.zeffy.com/embed/donation-form/donate-to-support-our-future-engineers-and-entrepreneurs"
              {...{ allowpaymentrequest: true, allowtransparency: 'true' }}
            ></iframe>
          </div>
        </div>
        {/* defer, so a third-party DNS lookup + handshake + download can't block parsing on
            the one page whose whole purpose is converting. The embed initialises on DOM ready
            and the onerror fallback below still fires either way. */}
        <script
          is:inline
          defer
          src="https://www.zeffy.com/embed/v2/zeffy-embed.js"
          onerror="document.querySelectorAll('[data-zeffy-embed-fallback]').forEach(function(el){el.style.display='block';el.querySelectorAll('iframe[data-zeffy-embed-src]').forEach(function(f){f.src=f.getAttribute('data-zeffy-embed-src');});});"
        ></script>
      </div>
      {/* The actionable ask sits above the legal note — a major gift shouldn't read as
          fine print, and the form above is sized for everyday giving. */}
      <p class="mt-6 max-w-xl text-sm text-slate-600" data-reveal>
        Planning a larger gift, or prefer to give another way? <a
          href="mailto:info@refineryrobotics.org?subject=Donating%20to%20The%20REFINERY"
          data-contact-open="contact"
          data-contact-topic="Donating"
          class="font-medium text-brand-accent underline hover:no-underline"
        >Get in touch</a> and we'll take it from there.
      </p>
      <p class="mt-4 max-w-xl text-xs text-slate-500" data-reveal>
        Donations are received by BioNanomics, a registered 501(c)(3) nonprofit, and are
        tax-deductible to the extent allowed by law.
      </p>
    </div>
  </section>
</MarketingLayout>
