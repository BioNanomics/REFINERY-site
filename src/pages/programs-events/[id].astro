---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import CTAButton from '../../components/marketing/CTAButton.astro';
import EventCoHosts from '../../components/marketing/EventCoHosts.astro';
import EventSponsors from '../../components/marketing/EventSponsors.astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import { firstPlain } from '../../utils/first';
import { event as eventSchema } from '../../utils/schema';
import { withBase } from '../../utils/base';
import { formatUtcDate } from '../../utils/dates';

export async function getStaticPaths() {
  // Deliberately no date filter. Past events stop appearing on the listing page, but keep
  // their URL — an indexed page or a shared link shouldn't turn into a 404 the morning after.
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const {
  title,
  summary,
  dateStart,
  dateEnd,
  startTime,
  endTime,
  location,
  venueAddress,
  registrationUrl,
  registrationLabel,
  registrationNote,
  isFree,
  coHosts,
  sponsors,
  seekingSponsors,
  heroImage,
  heroImageAlt,
  heroCredit,
  draft,
} = event.data;
const { Content } = await render(event);

// Only events with a structured venue address get Event schema — see src/utils/schema.ts.
const jsonLd = venueAddress
  ? eventSchema({
      name: firstPlain(title),
      description: firstPlain(summary),
      url: new URL(Astro.url.pathname, Astro.site).href,
      startDate: dateStart,
      endDate: dateEnd,
      startTime,
      endTime,
      venueName: location,
      venueAddress,
      isFree,
      registrationUrl,
      image: heroImage
        ? new URL((await getImage({ src: heroImage, width: 1200 })).src, Astro.site).href
        : undefined,
    })
  : undefined;

// Only shown when it's actually a different day — see the identical check on EventCard.astro.
const formattedEndDate =
  dateEnd && dateEnd.getTime() !== dateStart.getTime()
    ? formatUtcDate(dateEnd, { year: 'numeric', month: 'long', day: 'numeric' })
    : undefined;
---

<ArticleLayout
  title={title}
  summary={summary}
  pubDate={dateStart}
  author={location}
  heroImage={heroImage}
  heroImageAlt={heroImageAlt}
  heroCredit={heroCredit}
  isDraft={draft}
  jsonLd={jsonLd}
  sourcePath={event.filePath}
  breadcrumbs={[
    { label: 'Home', href: withBase('/') },
    { label: 'Programs & Events', href: withBase('programs-events/') },
    { label: title },
  ]}
>
  {
    formattedEndDate && (
      <p class="not-prose -mt-6 mb-8 font-mono text-xs text-slate-500">Through {formattedEndDate}</p>
    )
  }
  <Content />
  <EventCoHosts coHosts={coHosts} />
  <EventSponsors sponsors={sponsors} seekingSponsors={seekingSponsors} />
  {
    registrationNote && registrationUrl ? (
      // The participant handoff for an event pitched at spectators: set apart at the foot of
      // the page so the public copy above doesn't read as a sign-up page.
      <div class="not-prose mt-12 rounded-card border border-slate-200 bg-slate-50 p-6 sm:p-8" data-reveal>
        <p class="text-slate-700">{registrationNote}</p>
        <div class="mt-5 flex flex-wrap items-center gap-4">
          <CTAButton href={registrationUrl}>{registrationLabel ?? 'Register'}</CTAButton>
          {isFree && <p class="font-mono text-sm font-medium text-brand-accent">Free to attend</p>}
        </div>
      </div>
    ) : (
      (registrationUrl || isFree) && (
        <div class="not-prose mt-8 flex flex-wrap items-center gap-4">
          {registrationUrl && <CTAButton href={registrationUrl}>{registrationLabel ?? 'Register'}</CTAButton>}
          {/* Stated on the page, not just in the Event structured data — markup shouldn't
              claim free admission where a reader can't see it. */}
          {isFree && <p class="font-mono text-sm font-medium text-brand-accent">Free to attend</p>}
        </div>
      )
    )
  }
</ArticleLayout>
