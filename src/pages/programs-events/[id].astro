---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import CTAButton from '../../components/marketing/CTAButton.astro';
import { getCollection, render } from 'astro:content';
import { firstPlain } from '../../utils/first';
import { event as eventSchema } from '../../utils/schema';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => data.featured && !data.draft);
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { title, summary, dateStart, dateEnd, location, venueAddress, registrationUrl, draft } =
  event.data;
const { Content } = await render(event);

// Only events with a structured venue address get Event schema — see src/utils/schema.ts.
const jsonLd = venueAddress
  ? eventSchema({
      name: firstPlain(title),
      description: firstPlain(summary),
      url: new URL(Astro.url.pathname, Astro.site).href,
      startDate: dateStart,
      endDate: dateEnd,
      venueName: location,
      venueAddress,
    })
  : undefined;
---

<ArticleLayout
  title={title}
  summary={summary}
  pubDate={dateStart}
  author={location}
  isDraft={draft}
  jsonLd={jsonLd}
>
  <Content />
  {
    registrationUrl && (
      <div class="not-prose mt-8">
        <CTAButton href={registrationUrl}>Register</CTAButton>
      </div>
    )
  }
</ArticleLayout>
