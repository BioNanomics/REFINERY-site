---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import CTAButton from '../components/marketing/CTAButton.astro';
---

<MarketingLayout
  title="Contact"
  description="Get in touch with The REFINERY."
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-6 py-28 text-center">
    <SectionHeading eyebrow="Contact" title="Get in touch" align="center" />
    <p class="mt-4 text-slate-600">
      Questions about mentoring, partnerships, or our builds? Reach out — we'd love to hear from you.
    </p>
    <div class="mt-8">
      <CTAButton href="mailto:refinery@bionanomics.com">refinery@bionanomics.com</CTAButton>
    </div>
  </section>
</MarketingLayout>
