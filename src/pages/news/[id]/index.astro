---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Only internally-authored stories get a detail page; entries with a
  // sourceUrl link straight to the original publisher from the news grid.
  // Drafts are excluded outright, so an unreviewed story has no URL to index.
  const posts = await getCollection('news', ({ data }) => !data.sourceUrl && !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, summary, pubDate, author, heroImage, heroImageAlt, draft } = post.data;
const { Content } = await render(post);
---

<ArticleLayout
  title={title}
  summary={summary}
  pubDate={pubDate}
  author={author}
  heroImage={heroImage}
  heroImageAlt={heroImageAlt}
  isDraft={draft}
>
  <Content />
</ArticleLayout>
