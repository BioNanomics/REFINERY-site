---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import SectionHeading from '../../components/marketing/SectionHeading.astro';
import NewsGrid from '../../components/grids/NewsGrid.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('news', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<MarketingLayout
  title="Robotics News from Northeast Indiana"
  description="Updates from The REFINERY, our teams, and the broader Northeast Indiana robotics community."
>
  {/* section-tight, matching every other listing page. section-loose put this h1 64px lower
      than its siblings. No text-center on the section: the NewsGrid below is in here too, and
      SectionHeading's align="center" already centers its own block. */}
  <section class="section-tight section">
    <div class="section-inner">
      <SectionHeading
        as="h1"
        eyebrow="News"
        title="Updates from The REFINERY and the region"
        description="The REFINERY's news, team stories, event recaps, partnership updates, and coverage from across the FIRST community."
        align="center"
      />
      {/* The grid's cards are h3s, so without this the page jumps h1 -> h3. Visually hidden
          rather than shown: the h1 and the filter controls already say what this list is, so a
          visible "All stories" would be redundant to sighted readers while still giving screen
          reader users an unbroken heading outline. */}
      <h2 class="sr-only">All stories</h2>
      <div class="mt-10">
        <NewsGrid posts={posts} />
      </div>
    </div>
  </section>
</MarketingLayout>
