---
import '../styles/marketing.css';
import { Font } from 'astro:assets';
import { withBase } from '../utils/base';
import { firstPlain } from '../utils/first';

interface Props {
  title: string;
  description: string;
  image?: string;
  // A schema.org node (or array of them) to emit as JSON-LD. Optional, so pages that
  // have nothing worth describing simply don't pass it. Build these with the helpers in
  // src/utils/schema.ts rather than hand-writing objects at the call site.
  jsonLd?: object | object[];
  // Replaces the whole <title>, brand suffix included. For headlines long enough that
  // "| The REFINERY" would push past ~60 characters and get truncated anyway — better to
  // spend those characters on the headline and let og:site_name carry the brand.
  fullTitle?: string;
  type?: 'website' | 'article';
  // false emits noindex and skips the canonical entirely. Only the 404 page wants this.
  index?: boolean;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  // Emitted as article:published_time. Article pages only — do NOT pass an event's date
  // here; when an event happens is not when its page was published.
  publishedTime?: Date;
}

const DEFAULT_OG_IMAGE_ALT =
  "A competition robot and shop equipment inside The REFINERY's makerspace";

// REVIEW MODE: flip to true as part of the real launch (see README.md → Deployment). While
// false, every page emits noindex regardless of the `index` prop passed in, so the GitHub
// Pages review URL can be shared without landing in search results.
const SITE_INDEXABLE = false;

const {
  title: rawTitle,
  description: rawDescription,
  image = withBase('images/og-default.jpeg'),
  jsonLd,
  fullTitle,
  type = 'website',
  index = true,
  imageAlt = DEFAULT_OG_IMAGE_ALT,
  // Dimensions of public/images/og-default.jpeg. Article pages override with their hero's.
  imageWidth = 1200,
  imageHeight = 630,
  publishedTime,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const indexable = index && SITE_INDEXABLE;

// <title> and meta content can't carry italics, so FIRST® gets the closest compliant
// treatment the medium allows: capitals plus a registered symbol on first use.
const title = firstPlain(rawTitle);
const description = firstPlain(rawDescription);

// Append the brand unless doing so would push the title past what search results show. When
// it would, the tail that gets cut is always the brand, so it is better spent on the page's
// own words — og:site_name still carries the brand for social cards. This mainly affects long
// article headlines; every hand-written page title is comfortably inside the budget.
const TITLE_SUFFIX = ' | The REFINERY';
const MAX_TITLE_LENGTH = 60;
const suffixedTitle = `${title}${TITLE_SUFFIX}`;
const documentTitle = fullTitle
  ? firstPlain(fullTitle)
  : suffixedTitle.length <= MAX_TITLE_LENGTH
    ? suffixedTitle
    : title;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href={withBase('favicon.png')} />
<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
<meta name="generator" content={Astro.generator} />

<title>{documentTitle}</title>
<meta name="description" content={description} />

{/* A page excluded from search gets no canonical: pointing at itself would invite the URL
    to be treated as a real, indexable page. GitHub Pages serves 404.html with a genuine
    404 status, so this is belt-and-braces rather than a soft-404 fix. */}
{
  indexable ? (
    <link rel="canonical" href={canonicalURL} />
  ) : (
    <meta name="robots" content="noindex" />
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content="The REFINERY" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
{/* og:title deliberately omits the brand — og:site_name carries it, so repeating it here
    would render "The REFINERY" twice in a social card. */}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
{publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString().slice(0, 10)} />
)}

{/* twitter:title and twitter:description are intentionally absent — X falls back to the
    og: equivalents, so declaring them again is pure duplication. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

{/*
  Self-hosted — families are declared in astro.config.mjs. Preloads are limited to the faces
  that actually render above the fold, since preloading every weight and style would be ~18
  files and defeat the point: Inter 400 (body), 600 (.btn and the nav), 800 (the h1), and
  JetBrains Mono 400 (nav numerals) and 700 (.eyebrow-tag). Everything else, italics
  included, arrives via display: swap.
*/}
<Font
  cssVariable="--font-inter"
  preload={[
    { weight: 400, style: 'normal' },
    { weight: 600, style: 'normal' },
    { weight: 800, style: 'normal' },
  ]}
/>
<Font
  cssVariable="--font-jetbrains-mono"
  preload={[
    { weight: 400, style: 'normal' },
    { weight: 700, style: 'normal' },
  ]}
/>
