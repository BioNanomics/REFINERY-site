---
import '../styles/marketing.css';
import { Font } from 'astro:assets';
import { withBase } from '../utils/base';
import { firstPlain } from '../utils/first';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title: rawTitle, description: rawDescription, image = withBase('images/og-default.jpeg') } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// <title> and meta content can't carry italics, so FIRST® gets the closest compliant
// treatment the medium allows: capitals plus a registered symbol on first use.
const title = firstPlain(rawTitle);
const description = firstPlain(rawDescription);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href={withBase('favicon.png')} />
<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
<meta name="generator" content={Astro.generator} />

<title>{title} | The REFINERY</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta name="twitter:card" content="summary_large_image" />

{/*
  Self-hosted — families are declared in astro.config.mjs. Preloads are limited to the faces
  that actually render above the fold, since preloading every weight and style would be ~18
  files and defeat the point: Inter 400 (body), 600 (.btn and the nav), 800 (the h1), and
  JetBrains Mono 400 (nav numerals) and 700 (.eyebrow-tag). Everything else, italics
  included, arrives via display: swap.
*/}
<Font
  cssVariable="--font-inter"
  preload={[
    { weight: 400, style: 'normal' },
    { weight: 600, style: 'normal' },
    { weight: 800, style: 'normal' },
  ]}
/>
<Font
  cssVariable="--font-jetbrains-mono"
  preload={[
    { weight: 400, style: 'normal' },
    { weight: 700, style: 'normal' },
  ]}
/>
