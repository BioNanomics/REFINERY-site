---
import BaseHead from './BaseHead.astro';
import SiteHeader from '../components/nav/SiteHeader.astro';
import SiteFooter from '../components/nav/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="relative flex min-h-screen flex-col bg-white font-body text-slate-900 antialiased">
    <div class="grid-texture pointer-events-none fixed inset-0 -z-10 text-brand/[0.08]" aria-hidden="true"></div>
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
