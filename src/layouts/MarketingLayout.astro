---
import BaseHead from './BaseHead.astro';
import SiteHeader from '../components/nav/SiteHeader.astro';
import SiteFooter from '../components/nav/SiteFooter.astro';
import ContactDialogs from '../components/forms/ContactDialogs.astro';
import Breadcrumbs from '../components/marketing/Breadcrumbs.astro';
import { breadcrumbList } from '../utils/schema';
import { firstPlain } from '../utils/first';
import type { Crumb } from '../utils/breadcrumbs';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  fullTitle?: string;
  type?: 'website' | 'article';
  index?: boolean;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  publishedTime?: Date;
  /**
   * Breadcrumb trail, root first, current page last. Drives BOTH the visible <nav> and the
   * BreadcrumbList JSON-LD below, which is the point — one array, so the two can't disagree.
   *
   * Only for pages nested below the top level. A depth-1 page would render "Home › About",
   * which tells a reader nothing the primary nav doesn't already say.
   */
  breadcrumbs?: Crumb[];
  /** Narrower measure, to match ArticleLayout's prose column. Set by that layout, not by pages. */
  breadcrumbsNarrow?: boolean;
}

// Pass-through to BaseHead; see the prop docs there.
const {
  title,
  description,
  image,
  jsonLd,
  fullTitle,
  type,
  index,
  imageAlt,
  imageWidth,
  imageHeight,
  publishedTime,
  breadcrumbs,
  breadcrumbsNarrow = false,
} = Astro.props;

// Absolute URLs are resolved here rather than in schema.ts, matching how every other builder
// is fed: the builders stay pure and URL-agnostic, callers own Astro.site. The last crumb
// deliberately gets no URL — see breadcrumbList().
const crumbNode = breadcrumbs?.length
  ? breadcrumbList(
      breadcrumbs.map(({ label, href }, i) => ({
        name: firstPlain(label),
        url: i < breadcrumbs.length - 1 && href ? new URL(href, Astro.site).href : undefined,
      })),
    )
  : undefined;

// Normalize whatever the page passed (nothing, one node, or several) and append the trail.
// Collapsing a single node back to a bare object keeps output byte-identical for every page
// that passes no breadcrumbs, so adding this feature can't quietly reformat existing markup.
const nodes = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(crumbNode ? [crumbNode] : []),
];
const jsonLdOut = nodes.length === 0 ? undefined : nodes.length === 1 ? nodes[0] : nodes;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      jsonLd={jsonLdOut}
      fullTitle={fullTitle}
      type={type}
      index={index}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      publishedTime={publishedTime}
    />
    <script is:inline>
      // Only opt into the reveal system when JS runs AND the user hasn't
      // asked for reduced motion. If either is false, this class is never
      // added, .reveal's CSS never applies, and every [data-reveal]
      // element is simply visible by default — no flash-then-hide.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body class="relative flex min-h-screen flex-col bg-page font-body text-slate-900 antialiased">
    {/* The alpha here is the single knob for how strong the texture reads — see .grid-texture. */}
    {/* First focusable thing on every page — see .skip-link in marketing.css. */}
    <a href="#main" class="skip-link">Skip to main content</a>
    <div class="grid-texture pointer-events-none fixed inset-0 -z-10 text-brand/[0.055]" aria-hidden="true"></div>
    <SiteHeader />
    {/* has-breadcrumb-trail tightens the first section's top padding, since the trail already
        provides that gap — see the rule in marketing.css. Keeps a breadcrumbed page's heading
        at the same height as its siblings' instead of pushing it down by the trail's height. */}
    <main id="main" tabindex="-1" class:list={['flex-1', breadcrumbs?.length && 'has-breadcrumb-trail']}>
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} narrow={breadcrumbsNarrow} />}
      <slot />
    </main>
    <SiteFooter />
    <ContactDialogs />
    <script>
      function initReveal() {
        if (!document.documentElement.classList.contains('js-reveal')) return;

        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)');
        if (targets.length === 0) return;

        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        // Per-group stagger index, capped so a long grid doesn't trail for
        // ages after its last card enters the viewport. The cap is also a
        // latency floor: it's an ABSOLUTE index, so every item past it pays the
        // full cap x stagger delay before its own animation starts, even when
        // it scrolls into view alone. On the news page that's 20 of 25 cards.
        // Keep it low — 3 x 45ms = 135ms worst case.
        document.querySelectorAll('[data-reveal-group]').forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('[data-reveal]');
          items.forEach((el, i) => el.style.setProperty('--reveal-i', String(Math.min(i, 3))));
        });

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }

      // Every link that opens a new tab should say so before it does — a mid-sentence
      // link (P2.1's underline fix) or a news card can otherwise send a screen reader
      // user off-site with no warning. One central pass here covers every source: hand-
      // written .astro templates AND MDX article bodies, since rehype-external-links.mjs
      // (src/plugins/) already sets target="_blank" on off-site Markdown links before this
      // ever runs — so nothing at either the template or content level needs to opt in.
      //
      // Icon-only links (the footer's social row, TeamCard's glyphs) carry an aria-label
      // that already fully replaces the accessible name — appending a hidden span to their
      // content would do nothing, so the label itself gets extended instead. Everything
      // else gets a visually-hidden span; marketing.css's decorative ::after arrow stays
      // untouched either way, since this is the programmatic warning, not the visual one.
      //
      // data-newtab-noted guards against double-appending on repeat astro:page-load runs
      // (view transitions aren't in use today, but initReveal already future-proofs for
      // them, so this matches).
      function labelNewTabLinks() {
        document.querySelectorAll<HTMLAnchorElement>('a[target="_blank"]:not([data-newtab-noted])').forEach((a) => {
          a.dataset.newtabNoted = 'true';
          const label = a.getAttribute('aria-label');
          if (label) {
            a.setAttribute('aria-label', `${label} (opens in a new tab)`);
          } else {
            const note = document.createElement('span');
            note.className = 'sr-only';
            note.textContent = ' (opens in a new tab)';
            a.append(note);
          }
        });
      }

      initReveal();
      labelNewTabLinks();
      // No-op today (no client-side router is in use), but keeps this
      // correct if view transitions are ever enabled later.
      document.addEventListener('astro:page-load', initReveal);
      document.addEventListener('astro:page-load', labelNewTabLinks);
    </script>
  </body>
</html>
