---
import FirstText from '../components/brand/FirstText.astro';
import MarketingLayout from './MarketingLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  summary: string;
  pubDate: Date;
  author?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  isDraft?: boolean;
}

const { title, summary, pubDate, author, heroImage, heroImageAlt, isDraft } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<MarketingLayout title={title} description={summary}>
  <article class="section-inner section-inner-narrow section">
    {
      isDraft && (
        <p class="mb-6 rounded-control border border-amber-400 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-800">
          Draft content: not yet reviewed by The REFINERY team.
        </p>
      )
    }

    <header class="mb-8" data-reveal>
      <h1 class="font-heading text-3xl font-bold text-slate-900 sm:text-4xl"><FirstText text={title} context="heading" /></h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-slate-500">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {author && <span>&middot; {author}</span>}
      </div>
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          class="mb-10 w-full rounded-card object-cover shadow-card"
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 768px, 100vw"
          data-reveal
        />
      )
    }

    <div class="prose prose-slate max-w-none prose-headings:font-heading prose-a:text-brand-accent">
      <slot />
    </div>
  </article>
</MarketingLayout>
