---
import MarketingLayout from './MarketingLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  summary: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  isDraft?: boolean;
}

const { title, summary, pubDate, author, tags = [], heroImage, heroImageAlt, isDraft } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<MarketingLayout title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    {
      isDraft && (
        <p class="mb-6 rounded-sm border border-amber-400 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-800">
          Draft content — not yet reviewed by The REFINERY team.
        </p>
      )
    }

    <header class="mb-8">
      <h1 class="font-heading text-3xl font-bold text-slate-900 sm:text-4xl">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-slate-500">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {author && <span>&middot; {author}</span>}
      </div>
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="border border-slate-300 px-3 py-1 font-mono text-xs font-medium text-slate-600">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          class="mb-10 w-full rounded-sm object-cover"
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 768px, 100vw"
        />
      )
    }

    <div class="prose prose-slate max-w-none prose-headings:font-heading prose-a:text-brand-accent">
      <slot />
    </div>
  </article>
</MarketingLayout>
