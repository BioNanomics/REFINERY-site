---
import FirstText from '../components/brand/FirstText.astro';
import MarketingLayout from './MarketingLayout.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  summary: string;
  pubDate: Date;
  author?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  isDraft?: boolean;
  jsonLd?: object | object[];
  // og:type. Left to the caller because this layout serves both news posts and events.
  type?: 'website' | 'article';
  // article:published_time. Only news should pass this — `pubDate` doubles as the event date
  // on the event route, and when an event happens isn't when its page was published.
  publishedTime?: Date;
}

const {
  title,
  summary,
  pubDate,
  author,
  heroImage,
  heroImageAlt,
  isDraft,
  jsonLd,
  type,
  publishedTime,
} = Astro.props;

// The hero was never forwarded to BaseHead, so every article and event page fell back to the
// site-wide OG card even when the entry had its own image. Resolve it to an absolute URL so
// the social card matches the article, and reuse the resolved dimensions for og:image:width
// and :height rather than recomputing them.
const heroOg = heroImage ? await getImage({ src: heroImage, width: 1200 }) : undefined;
const ogImage = heroOg ? new URL(heroOg.src, Astro.site).href : undefined;


// timeZone: 'UTC' — frontmatter dates are bare `YYYY-MM-DD`, which parse as UTC midnight.
// Without this, formatting in a behind-UTC locale renders the previous day.
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<MarketingLayout
  title={title}
  description={summary}
  image={ogImage}
  jsonLd={jsonLd}
  type={type}
  publishedTime={publishedTime}
  imageAlt={heroImageAlt}
  imageWidth={heroOg ? Number(heroOg.attributes.width) : undefined}
  imageHeight={heroOg ? Number(heroOg.attributes.height) : undefined}
>
  <article class="section-inner section-inner-narrow section">
    {
      isDraft && (
        <p class="mb-6 rounded-control border border-amber-400 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-800">
          Draft content: not yet reviewed by The REFINERY team.
        </p>
      )
    }

    <header class="mb-8" data-reveal>
      <h1 class="font-heading text-3xl font-bold text-slate-900 sm:text-4xl"><FirstText text={title} context="heading" /></h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-slate-500">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {author && <span>&middot; {author}</span>}
      </div>
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          class="mb-10 w-full rounded-card object-cover shadow-card"
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 768px, 100vw"
          data-reveal
        />
      )
    }

    <div class="prose prose-slate max-w-none prose-headings:font-heading prose-a:text-brand-accent">
      <slot />
    </div>
  </article>
</MarketingLayout>
